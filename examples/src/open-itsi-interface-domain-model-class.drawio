  <diagram id="open-itsi-interface-domain-model" name="Interface Domain Model">
    <mxGraphModel dx="7300" dy="4320" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="7300" pageHeight="4320" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="background" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;shadow=0;" vertex="1" parent="1">
          <mxGeometry width="7300" height="4320" as="geometry"/>
        </mxCell>
        <mxCell id="diagram-title" value="Open ITSI Interface Domain Model — UML Class Diagram" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontStyle=1;fontColor=#17202A;" vertex="1" parent="1">
          <mxGeometry x="60" y="28" width="7180" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="diagram-subtitle" value="Canonical/post-normalization and policy slice • package-backed raw Alerts normalize before this domain through four Ingest methods • API/Kafka/webhook/source bindings establish trusted scope • response and Kafka envelopes carry explicit scope" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#34495E;" vertex="1" parent="1">
          <mxGeometry x="60" y="88" width="7180" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="scope-note" value="&lt;b&gt;Reading rule:&lt;/b&gt; &lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; marks native `.spl` field parity; &lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; marks Open-ITSI additions. Raw Alerts enter by API, Open ITSI Kafka, inbound webhook, or External Kafka. API uses trusted header context; Kafka envelope or stored endpoint/source binding supplies scope for the other transports. One immutable package-derived revision produces the Notable below. No HTTP polling or SPL search executes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#7F8C8D;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=15;fontColor=#34495E;shadow=0;dashed=1;dashPattern=7 5;" vertex="1" parent="1">
          <mxGeometry x="780" y="145" width="5740" height="90" as="geometry"/>
        </mxCell>

        <!-- Canonical / Splunk-compatible domain -->
        <mxCell id="core-band" value="&lt;b&gt;CANONICAL / SPLUNK-COMPATIBLE DOMAIN&lt;/b&gt;&lt;br&gt;Native names and opaque vendor fields are preserved; Open-ITSI materializes a query-ready Episode aggregate without reimplementing package decisions." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2FBF8;strokeColor=#148F77;strokeWidth=3;align=left;verticalAlign=top;spacingTop=18;spacingLeft=22;spacingRight=14;fontFamily=Helvetica;fontSize=19;fontColor=#0E6655;container=1;collapsible=0;recursiveResize=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="7180" height="1030" as="geometry"/>
        </mxCell>

        <!-- NotableEvent class -->
        <mxCell id="notable-class" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#148F77;strokeWidth=2.5;container=1;collapsible=0;recursiveResize=0;shadow=0;" vertex="1" parent="core-band">
          <mxGeometry x="60" y="140" width="620" height="730" as="geometry"/>
        </mxCell>
        <mxCell id="notable-header" value="&lt;i&gt;«domain object»&lt;/i&gt;&lt;br&gt;&lt;b&gt;NotableEvent&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;HTTP body • Kafka envelope.notable • no tenant metadata&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#17202A;" vertex="1" parent="notable-class">
          <mxGeometry x="0" y="0" width="620" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="notable-sep" value="" style="rounded=0;fillColor=#148F77;strokeColor=#148F77;strokeWidth=1;" vertex="1" parent="notable-class">
          <mxGeometry x="0" y="92" width="620" height="1" as="geometry"/>
        </mxCell>
        <mxCell id="notable-attrs" value="&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; event_id: String {required}&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; _time: Number {required, finite}&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; title: String?&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; description: String?&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; source: String?&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; host: String?&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; severity: String | Number?&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; status: String | Number?&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; owner: String?&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; additionalProperties: JsonValue[*]&lt;br&gt;&lt;br&gt;&lt;b&gt;Invariant:&lt;/b&gt; immutable event identity; NEAP-selected fields remain opaque." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=18;spacingRight=14;spacingTop=16;fontFamily=Helvetica;fontSize=14;fontColor=#17202A;" vertex="1" parent="notable-class">
          <mxGeometry x="0" y="93" width="620" height="637" as="geometry"/>
        </mxCell>
        <mxCell id="notable-json" value="HTTP header (not JSON)&#xa;x-oauth2-tenant-id: tenant-42&#xa;&#xa;NotableEvent body&#xa;&#xa;{&#xa;  &quot;event_id&quot;: &quot;n-101&quot;,&#xa;  &quot;_time&quot;: 1788201000,&#xa;  &quot;title&quot;: &quot;VPN path down&quot;,&#xa;  &quot;description&quot;: &quot;WAN1 unreachable&quot;,&#xa;  &quot;source&quot;: &quot;meraki&quot;,&#xa;  &quot;host&quot;: &quot;mx-7&quot;,&#xa;  &quot;severity&quot;: &quot;5&quot;,&#xa;  &quot;status&quot;: &quot;1&quot;,&#xa;  &quot;owner&quot;: &quot;unassigned&quot;&#xa;}&#xa;&#xa;SPL parity: same extensible field bag.&#xa;Standalone injects tenant only into the package-facing copy." style="shape=note;size=34;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#148F77;strokeWidth=2;fontFamily=Courier New;fontSize=13;fontColor=#17202A;shadow=0;" vertex="1" parent="core-band">
          <mxGeometry x="710" y="140" width="1010" height="730" as="geometry"/>
        </mxCell>

        <!-- NEAP class -->
        <mxCell id="neap-class" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#148F77;strokeWidth=2.5;container=1;collapsible=0;recursiveResize=0;shadow=0;" vertex="1" parent="core-band">
          <mxGeometry x="1820" y="140" width="620" height="730" as="geometry"/>
        </mxCell>
        <mxCell id="neap-header" value="&lt;i&gt;«policy»&lt;/i&gt;&lt;br&gt;&lt;b&gt;NEAP&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B03A2E&quot;&gt;CUSTOM POLICY WITHOUT tenant_id SPLIT IS UNSAFE&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#17202A;" vertex="1" parent="neap-class">
          <mxGeometry x="0" y="0" width="620" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="neap-sep" value="" style="rounded=0;fillColor=#148F77;strokeColor=#148F77;strokeWidth=1;" vertex="1" parent="neap-class">
          <mxGeometry x="0" y="92" width="620" height="1" as="geometry"/>
        </mxCell>
        <mxCell id="neap-attrs" value="&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; _key: String&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; title: String&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; disabled: Boolean | 0 | 1&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; object_type: notable_aggregation_policy&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; filter_criteria: Clause&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; split_by_field: String&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; breaking_criteria: Clause&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; group_title: Template?&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; group_description: Template?&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; group_severity: Template&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; rules: Rule[0..*]&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; additionalProperties: JsonValue[*]&lt;br&gt;&lt;br&gt;&lt;b&gt;Authority:&lt;/b&gt; exact package-owned JSON semantics.&lt;br&gt;&lt;font color=&quot;#B03A2E&quot;&gt;&lt;b&gt;MT invariant:&lt;/b&gt; split_by_field must include tenant_id; arbitrary custom NEAPs are not guarded today.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=18;spacingRight=14;spacingTop=16;fontFamily=Helvetica;fontSize=14;fontColor=#17202A;" vertex="1" parent="neap-class">
          <mxGeometry x="0" y="93" width="620" height="637" as="geometry"/>
        </mxCell>
        <mxCell id="neap-json" value="Tenant-safe example JSON&#xa;&#xa;{&#xa;  &quot;_key&quot;: &quot;group-by-host&quot;,&#xa;  &quot;title&quot;: &quot;Group by host&quot;,&#xa;  &quot;disabled&quot;: 0,&#xa;  &quot;object_type&quot;: &quot;notable_aggregation_policy&quot;,&#xa;  &quot;filter_criteria&quot;: {&#xa;    &quot;condition&quot;: &quot;AND&quot;,&#xa;    &quot;items&quot;: []&#xa;  },&#xa;  &quot;split_by_field&quot;:&#xa;    &quot;tenant_id,host&quot;,&#xa;  &quot;breaking_criteria&quot;: {&#xa;    &quot;condition&quot;: &quot;OR&quot;,&#xa;    &quot;items&quot;: [{&#xa;      &quot;type&quot;: &quot;pause&quot;,&#xa;      &quot;config&quot;: {&quot;limit&quot;: &quot;1800&quot;}&#xa;    }]&#xa;  },&#xa;  &quot;group_title&quot;: &quot;%title%&quot;,&#xa;  &quot;group_severity&quot;: &quot;%severity%&quot;,&#xa;  &quot;rules&quot;: []&#xa;}&#xa;&#xa;Tenant-safe policies include tenant_id.&#xa;Custom omission is unsafe / unsupported." style="shape=note;size=34;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#B03A2E;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontColor=#17202A;shadow=0;" vertex="1" parent="core-band">
          <mxGeometry x="2470" y="140" width="1010" height="730" as="geometry"/>
        </mxCell>

        <!-- GroupedEvent class -->
        <mxCell id="grouped-event-class" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#148F77;strokeWidth=2.5;container=1;collapsible=0;recursiveResize=0;shadow=0;" vertex="1" parent="core-band">
          <mxGeometry x="3580" y="140" width="620" height="730" as="geometry"/>
        </mxCell>
        <mxCell id="grouped-event-header" value="&lt;i&gt;«member snapshot»&lt;/i&gt;&lt;br&gt;&lt;b&gt;GroupedEvent&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;Packaged grouped-HEC output&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#17202A;" vertex="1" parent="grouped-event-class">
          <mxGeometry x="0" y="0" width="620" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="grouped-event-sep" value="" style="rounded=0;fillColor=#148F77;strokeColor=#148F77;strokeWidth=1;" vertex="1" parent="grouped-event-class">
          <mxGeometry x="0" y="92" width="620" height="1" as="geometry"/>
        </mxCell>
        <mxCell id="grouped-event-attrs" value="&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; event_id: String&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN PRIVATE&lt;/font&gt; tenant_id: String&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN PRIVATE&lt;/font&gt; openitsi_source_event_id: String&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN PRIVATE&lt;/font&gt; openitsi_source_message_id: String&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; originalNotableFields: JsonValue[*]&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; itsi_group_id: String&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; itsi_policy_id: String?&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; itsi_group_count: Number?&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; itsi_first_event_time / itsi_last_event_time: Number?&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; itsi_group_title / itsi_group_description: String?&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; itsi_group_severity / status: String | Number?&lt;br&gt;&lt;br&gt;&lt;b&gt;Canonical ingress invariant:&lt;/b&gt; package event_id is a tenant-qualified surrogate. Public HTTP/Kafka projections restore the source event_id and strip private adapter fields." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=18;spacingRight=14;spacingTop=16;fontFamily=Helvetica;fontSize=13;fontColor=#17202A;" vertex="1" parent="grouped-event-class">
          <mxGeometry x="0" y="93" width="620" height="637" as="geometry"/>
        </mxCell>
        <mxCell id="grouped-event-json" value="Package-facing grouped output&#xa;&#xa;{&#xa;  &quot;event_id&quot;:&#xa;    &quot;openitsi:tenant-event:v1:&lt;sha256&gt;&quot;,&#xa;  &quot;tenant_id&quot;: &quot;tenant-42&quot;,&#xa;  &quot;openitsi_source_event_id&quot;: &quot;n-101&quot;,&#xa;  &quot;openitsi_source_message_id&quot;:&#xa;    &quot;submission-123&quot;,&#xa;  &quot;_time&quot;: 1788201000,&#xa;  &quot;source&quot;: &quot;meraki&quot;,&#xa;  &quot;host&quot;: &quot;mx-7&quot;,&#xa;  &quot;itsi_group_id&quot;: &quot;ep-42&quot;,&#xa;  &quot;itsi_policy_id&quot;: &quot;group-by-host&quot;,&#xa;  &quot;itsi_group_count&quot;: 2,&#xa;  &quot;itsi_last_event_time&quot;: 1788201060,&#xa;  &quot;itsi_group_title&quot;:&#xa;    &quot;Branch connectivity degraded&quot;,&#xa;  &quot;itsi_group_severity&quot;: &quot;5&quot;,&#xa;  &quot;itsi_group_status&quot;: &quot;1&quot;&#xa;}&#xa;&#xa;The `.spl` authors grouping fields. Standalone-added&#xa;identity/provenance is private and mechanically reversed&#xa;at public HTTP and Kafka egress boundaries." style="shape=note;size=34;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#148F77;strokeWidth=2;fontFamily=Courier New;fontSize=11;fontColor=#17202A;shadow=0;" vertex="1" parent="core-band">
          <mxGeometry x="4230" y="140" width="1010" height="730" as="geometry"/>
        </mxCell>

        <!-- EpisodeAggregate class -->
        <mxCell id="episode-class" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#148F77;strokeWidth=2.5;container=1;collapsible=0;recursiveResize=0;shadow=0;" vertex="1" parent="core-band">
          <mxGeometry x="5340" y="140" width="620" height="730" as="geometry"/>
        </mxCell>
        <mxCell id="episode-header" value="&lt;i&gt;«aggregate»&lt;/i&gt;&lt;br&gt;&lt;b&gt;EpisodeAggregate&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;System + user + grouped snapshots&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#17202A;" vertex="1" parent="episode-class">
          <mxGeometry x="0" y="0" width="620" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="episode-sep" value="" style="rounded=0;fillColor=#148F77;strokeColor=#148F77;strokeWidth=1;" vertex="1" parent="episode-class">
          <mxGeometry x="0" y="92" width="620" height="1" as="geometry"/>
        </mxCell>
        <mxCell id="episode-attrs" value="&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; _key: String&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; itsi_group_id: String&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; itsi_policy_id: String?&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; title: String?&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; description: String?&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; event_count: Integer&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; start_time: Number?&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; last_time: Number?&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; is_active: Boolean | 0 | 1&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; severity / status / owner: scalar?&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; system: JsonObject&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; user: JsonObject?&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; members: GroupedEvent[1..*]&lt;br&gt;&lt;br&gt;&lt;b&gt;Interface aliases and revision metadata are added below.&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=18;spacingRight=14;spacingTop=16;fontFamily=Helvetica;fontSize=13;fontColor=#17202A;" vertex="1" parent="episode-class">
          <mxGeometry x="0" y="93" width="620" height="637" as="geometry"/>
        </mxCell>
        <mxCell id="episode-json" value="Example conceptual aggregate&#xa;&#xa;{&#xa;  &quot;_key&quot;: &quot;ep-42&quot;,&#xa;  &quot;itsi_group_id&quot;: &quot;ep-42&quot;,&#xa;  &quot;itsi_policy_id&quot;: &quot;group-by-topology&quot;,&#xa;  &quot;title&quot;:&#xa;    &quot;Branch connectivity degraded&quot;,&#xa;  &quot;description&quot;:&#xa;    &quot;Meraki + TE symptoms&quot;,&#xa;  &quot;event_count&quot;: 2,&#xa;  &quot;start_time&quot;: 1788201000,&#xa;  &quot;last_time&quot;: 1788201060,&#xa;  &quot;is_active&quot;: 1,&#xa;  &quot;severity&quot;: &quot;5&quot;,&#xa;  &quot;status&quot;: &quot;1&quot;,&#xa;  &quot;owner&quot;: &quot;unassigned&quot;&#xa;}&#xa;&#xa;Native ITSI stores system, user, and grouped-event&#xa;sources separately; this row is their effective join." style="shape=note;size=34;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#148F77;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontColor=#17202A;shadow=0;" vertex="1" parent="core-band">
          <mxGeometry x="5990" y="140" width="1010" height="730" as="geometry"/>
        </mxCell>

        <!-- Interface representations -->
        <mxCell id="interface-band" value="&lt;b&gt;OPEN-ITSI INTERFACE REPRESENTATIONS&lt;/b&gt;&lt;br&gt;Management/API calls use `x-oauth2-tenant-id`; the POC webhook endpoint and External Kafka source resolve scope from stored connection bindings. Response envelopes echo validated scope while domain items stay clean. Kafka egress emits an append-only Episode membership delta." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5FAFE;strokeColor=#2874A6;strokeWidth=3;align=left;verticalAlign=top;spacingTop=18;spacingLeft=22;spacingRight=14;fontFamily=Helvetica;fontSize=19;fontColor=#1B4F72;container=1;collapsible=0;recursiveResize=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1380" width="7180" height="1030" as="geometry"/>
        </mxCell>

        <!-- Kafka Notable envelope -->
        <mxCell id="notable-envelope-class" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#2874A6;strokeWidth=2.5;container=1;collapsible=0;recursiveResize=0;shadow=0;" vertex="1" parent="interface-band">
          <mxGeometry x="60" y="140" width="620" height="730" as="geometry"/>
        </mxCell>
        <mxCell id="notable-envelope-header" value="&lt;i&gt;«Kafka envelope»&lt;/i&gt;&lt;br&gt;&lt;b&gt;NotableEnvelopeV1&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;KAFKA WIRE CONTRACT ONLY&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#17202A;" vertex="1" parent="notable-envelope-class">
          <mxGeometry x="0" y="0" width="620" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="notable-envelope-sep" value="" style="rounded=0;fillColor=#2874A6;strokeColor=#2874A6;strokeWidth=1;" vertex="1" parent="notable-envelope-class">
          <mxGeometry x="0" y="92" width="620" height="1" as="geometry"/>
        </mxCell>
        <mxCell id="notable-envelope-attrs" value="&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; schema_version: openitsi.notable.v1&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; message_id: String&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; event_type: notable.created&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; content_digest: sha256:String?&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; scope.tenant_id: String&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= DOMAIN&lt;/font&gt; notable: NotableEvent&lt;br&gt;&lt;br&gt;&lt;b&gt;Identity:&lt;/b&gt;&lt;br&gt;submission = (tenant_id, message_id)&lt;br&gt;business = (tenant_id, notable.event_id)&lt;br&gt;&lt;br&gt;Kafka record key is ignored on ingress." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=18;spacingRight=14;spacingTop=16;fontFamily=Helvetica;fontSize=14;fontColor=#17202A;" vertex="1" parent="notable-envelope-class">
