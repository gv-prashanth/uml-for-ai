        <mxCell id="clause-attrs" value="&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; condition: AND | OR&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; items: ClauseItem[0..*]&lt;br&gt;&lt;br&gt;&lt;b&gt;ClauseItem&lt;/b&gt;&lt;br&gt;type: String&lt;br&gt;config: JsonObject&lt;br&gt;&lt;br&gt;&lt;b&gt;Common item types&lt;/b&gt;&lt;br&gt;notable_event_field&lt;br&gt;notable_event_count&lt;br&gt;pause&lt;br&gt;duration&lt;br&gt;clause&lt;br&gt;&lt;br&gt;The package interprets every type/config pair." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=18;spacingRight=14;spacingTop=16;fontFamily=Helvetica;fontSize=14;fontColor=#17202A;" vertex="1" parent="clause-class">
