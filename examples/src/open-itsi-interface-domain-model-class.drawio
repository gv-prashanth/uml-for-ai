        <mxCell id="action-exec-attrs" value="&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; _key: String&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; status: in_progress | succeeded | failed | unknown&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; action_name: String?&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; started_at: Number&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; finished_at: Number?&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; exit_code: Integer?&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; error / outcome_reason: String?&lt;br&gt;&lt;br&gt;No exact native public API counterpart; package queue semantics remain unchanged.&lt;br&gt;Newest-first collection page is bounded: total is exact only when complete and otherwise explicitly a lower bound." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=18;spacingRight=14;spacingTop=12;fontFamily=Helvetica;fontSize=11;fontColor=#17202A;" vertex="1" parent="action-exec-class"><mxGeometry x="0" y="69" width="620" height="281" as="geometry"/></mxCell>
