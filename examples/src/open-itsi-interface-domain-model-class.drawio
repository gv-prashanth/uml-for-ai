        <mxCell id="webhook-sep" value="" style="rounded=0;fillColor=#148F77;strokeColor=#148F77;strokeWidth=1;" vertex="1" parent="webhook-class"><mxGeometry x="0" y="68" width="620" height="1" as="geometry"/></mxCell>
