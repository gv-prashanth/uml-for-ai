        <!-- Policy parts and actions -->
        <mxCell id="support-band" value="&lt;b&gt;NATIVE POLICY PARTS + ACTION INTERFACES&lt;/b&gt;&lt;br&gt;The native `.spl` owns these documents: RankingConfig orders NEAP references; NEAP embeds filter/break Clauses and Rules; Rule action items may reference outbound action Webhooks. This is distinct from the inbound webhook Ingest method. Only ActionExecution is an Open-ITSI projection." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFCFC;strokeColor=#5D6D7E;strokeWidth=3;align=left;verticalAlign=top;spacingTop=18;spacingLeft=22;spacingRight=14;fontFamily=Helvetica;fontSize=19;fontColor=#34495E;container=1;collapsible=0;recursiveResize=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="2480" width="7180" height="1050" as="geometry"/>
        </mxCell>

