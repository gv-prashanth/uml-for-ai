        <mxCell id="notable-page-json" value="Example JSON&#xa;&#xa;{&#xa;  &quot;scope&quot;: {&quot;tenant_id&quot;: &quot;tenant-42&quot;},&#xa;  &quot;items&quot;: [{&#xa;    &quot;event_id&quot;: &quot;n-101&quot;,&#xa;    &quot;_time&quot;: 1788201000,&#xa;    &quot;title&quot;: &quot;VPN path down&quot;&#xa;  }],&#xa;  &quot;offset&quot;: 0,&#xa;  &quot;limit&quot;: 100,&#xa;  &quot;count&quot;: 1,&#xa;  &quot;total&quot;: 1,&#xa;  &quot;has_more&quot;: false,&#xa;  &quot;next_offset&quot;: null,&#xa;  &quot;serialized_event_bytes&quot;: 92,&#xa;  &quot;max_page_bytes&quot;: 7340032,&#xa;  &quot;byte_truncated&quot;: false&#xa;}&#xa;&#xa;Scope is response provenance; items retain the clean&#xa;domain object and contain no tenant/adapter fields." style="shape=note;size=34;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#2874A6;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontColor=#17202A;shadow=0;" vertex="1" parent="interface-band">
