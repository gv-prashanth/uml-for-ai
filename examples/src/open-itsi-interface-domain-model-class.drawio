        <mxCell id="clause-json" value="Example JSON&#xa;&#xa;{&#xa;  &quot;condition&quot;: &quot;AND&quot;,&#xa;  &quot;items&quot;: [{&#xa;    &quot;type&quot;: &quot;notable_event_field&quot;,&#xa;    &quot;config&quot;: {&#xa;      &quot;field&quot;: &quot;source&quot;,&#xa;      &quot;operator&quot;: &quot;=&quot;,&#xa;      &quot;value&quot;: &quot;meraki&quot;&#xa;    }&#xa;  }]&#xa;}&#xa;&#xa;SPL parity: exact nested clause is retained." style="shape=note;size=34;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#148F77;strokeWidth=2;fontFamily=Courier New;fontSize=12;fontColor=#17202A;shadow=0;" vertex="1" parent="support-band">
