        <mxCell id="rel-episode-grouped" value="member snapshots" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=diamondThin;startFill=0;startSize=18;endArrow=none;strokeColor=#148F77;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#0E6655;labelBackgroundColor=#F2FBF8;exitX=0.2;exitY=1;entryX=0.8;entryY=1;" edge="1" parent="1" source="episode-class" target="grouped-event-class"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5524" y="1270"/><mxPoint x="4136" y="1270"/></Array></mxGeometry></mxCell>
