        <mxCell id="notable-page-attrs" value="&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; scope: TenantScope {required}&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; scope.tenant_id: String&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= DOMAIN&lt;/font&gt; items: NotableEvent[0..1000]&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; offset: Integer&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; limit: Integer&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; count / total: Integer&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; has_more: Boolean&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; next_offset: Integer?&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; serialized_event_bytes: Integer?&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; max_page_bytes: Integer?&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; byte_truncated: Boolean?&lt;br&gt;&lt;br&gt;&lt;b&gt;Request context (not a Notable member):&lt;/b&gt; `x-oauth2-tenant-id`&lt;br&gt;&lt;b&gt;Response invariant:&lt;/b&gt; scope echoes the exact validated tenant even when items is empty.&lt;br&gt;&lt;b&gt;Privileged direct-Core compatibility POST:&lt;/b&gt; `/api/internal/notable-events` body is NotableEvent or NotableEvent[1..1000]." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=18;spacingRight=14;spacingTop=16;fontFamily=Helvetica;fontSize=13;fontColor=#17202A;" vertex="1" parent="notable-page-class">
