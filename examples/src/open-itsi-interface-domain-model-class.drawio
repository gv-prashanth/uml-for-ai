        <mxCell id="episode-delta-attrs" value="&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; schema_version: openitsi.episode-event.v1&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; message_id: sha256:String&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; event_type: episode.membership_added&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; emitted_at: ISO8601&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; scope.tenant_id: String&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= REF&lt;/font&gt; episode.episode_id: String&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= REF&lt;/font&gt; episode.policy_id: String?&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; episode.revision: Integer&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; episode.member_count: Integer&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= REF&lt;/font&gt; membership.event_id: String&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; membership.source_message_id: String&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; membership.source_content_digest: sha256&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; provenance.grouped_hec_id: Integer" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=18;spacingRight=14;spacingTop=16;fontFamily=Helvetica;fontSize=13;fontColor=#17202A;" vertex="1" parent="episode-delta-class">
