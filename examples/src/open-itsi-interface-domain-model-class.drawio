        <mxCell id="rule-json" value="Example JSON&#xa;&#xa;{&#xa;  &quot;_key&quot;: &quot;notify-ops&quot;,&#xa;  &quot;title&quot;: &quot;Notify operations&quot;,&#xa;  &quot;activation_criteria&quot;: {&#xa;    &quot;condition&quot;: &quot;AND&quot;,&#xa;    &quot;items&quot;: []&#xa;  },&#xa;  &quot;actions&quot;: [{&#xa;    &quot;condition&quot;: &quot;AND&quot;,&#xa;    &quot;items&quot;: [{&#xa;      &quot;type&quot;: &quot;itsi_event_action_webhook&quot;,&#xa;      &quot;config&quot;: {&quot;webhook&quot;: &quot;ops-hook&quot;},&#xa;      &quot;execution_criteria&quot;: {}&#xa;    }]&#xa;  }]&#xa;}&#xa;&#xa;SPL parity: unchanged package evaluates it." style="shape=note;size=34;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#148F77;strokeWidth=2;fontFamily=Courier New;fontSize=11;fontColor=#17202A;shadow=0;" vertex="1" parent="support-band">
