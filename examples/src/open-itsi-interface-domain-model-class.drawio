        <mxCell id="episode-detail-json" value="Example JSON&#xa;&#xa;{&#xa;  &quot;_key&quot;: &quot;ep-42&quot;,&#xa;  &quot;episode_id&quot;: &quot;ep-42&quot;,&#xa;  &quot;itsi_group_id&quot;: &quot;ep-42&quot;,&#xa;  &quot;scope&quot;: {&quot;tenant_id&quot;: &quot;tenant-42&quot;},&#xa;  &quot;title&quot;: &quot;Branch connectivity degraded&quot;,&#xa;  &quot;event_count&quot;: 2,&#xa;  &quot;severity&quot;: &quot;5&quot;,&#xa;  &quot;status&quot;: &quot;1&quot;,&#xa;  &quot;owner&quot;: &quot;alice&quot;,&#xa;  &quot;events&quot;: [{&#xa;    &quot;event_id&quot;: &quot;n-101&quot;,&#xa;    &quot;itsi_group_id&quot;: &quot;ep-42&quot;&#xa;  }],&#xa;  &quot;system&quot;: {&quot;event_count&quot;: 2},&#xa;  &quot;user&quot;: {&quot;owner&quot;: &quot;alice&quot;},&#xa;  &quot;_openitsi_projection&quot;: {&#xa;    &quot;mode&quot;: &quot;detail&quot;,&#xa;    &quot;members_available&quot;: 2,&#xa;    &quot;members_returned&quot;: 1,&#xa;    &quot;members_truncated&quot;: true,&#xa;    &quot;response_byte_limit&quot;: 7340032&#xa;  }&#xa;}&#xa;&#xa;Member event_id is restored to the source identity;&#xa;private package hashes/provenance are not exposed." style="shape=note;size=34;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#2874A6;strokeWidth=2;fontFamily=Courier New;fontSize=11;fontColor=#17202A;shadow=0;" vertex="1" parent="interface-band">
