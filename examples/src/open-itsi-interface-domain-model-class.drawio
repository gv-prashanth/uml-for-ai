        <mxCell id="ranking-class" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#148F77;strokeWidth=2.5;container=1;collapsible=0;recursiveResize=0;shadow=0;" vertex="1" parent="support-band">
