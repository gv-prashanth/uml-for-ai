        <mxCell id="episode-detail-attrs" value="&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; _key: String&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; episode_id: String&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; itsi_group_id: String&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; scope: TenantScope {required}&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; scope.tenant_id: String&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; presentation aliases: JsonValue[*]&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; events: GroupedEvent[0..1000]&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; system / user: JsonObject&lt;br&gt;&lt;font color=&quot;#C25700&quot;&gt;+ OPEN&lt;/font&gt; _openitsi_projection: ProjectionInfo&lt;br&gt;&lt;br&gt;&lt;b&gt;ProjectionInfo&lt;/b&gt;&lt;br&gt;mode: summary | detail&lt;br&gt;members_available / returned: Integer&lt;br&gt;members_truncated: Boolean&lt;br&gt;response_byte_limit: Integer&lt;br&gt;&lt;br&gt;&lt;b&gt;Request context (not a member):&lt;/b&gt; `x-oauth2-tenant-id`&lt;br&gt;&lt;b&gt;Response invariant:&lt;/b&gt; scope exactly matches the request tenant. List/detail/similar resolve owned opaque route + typed/HEC sources; shared package system/user KV is never tenant authority." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=18;spacingRight=14;spacingTop=16;fontFamily=Helvetica;fontSize=12;fontColor=#17202A;" vertex="1" parent="episode-detail-class">
