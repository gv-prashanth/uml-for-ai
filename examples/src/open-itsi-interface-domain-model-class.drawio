          <mxGeometry x="0" y="0" width="620" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="ranking-sep" value="" style="rounded=0;fillColor=#148F77;strokeColor=#148F77;strokeWidth=1;" vertex="1" parent="ranking-class"><mxGeometry x="0" y="92" width="620" height="1" as="geometry"/></mxCell>
        <mxCell id="ranking-attrs" value="&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; _key: ranking-config&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; object_type: neap_ranking_configuration&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; mod_time: Number?&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;= ITSI&lt;/font&gt; priorities: RankingEntry[0..*]&lt;br&gt;&lt;br&gt;&lt;b&gt;RankingEntry&lt;/b&gt;&lt;br&gt;neap_reference: String&lt;br&gt;priority: Integer [0..999]&lt;br&gt;&lt;br&gt;&lt;b&gt;Authority:&lt;/b&gt; Java evaluation order; NEAP.priority is not the ranking source of truth." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=18;spacingRight=14;spacingTop=16;fontFamily=Helvetica;fontSize=14;fontColor=#17202A;" vertex="1" parent="ranking-class">
          <mxGeometry x="0" y="93" width="620" height="657" as="geometry"/>
        </mxCell>
