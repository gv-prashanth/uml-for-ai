  <diagram id="itsi-standalone-postgresql-phase0" name="Current PostgreSQL model">
    <mxGraphModel dx="5600" dy="4450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5600" pageHeight="4450" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="erd-root"/>
        <mxCell id="erd-layer" parent="erd-root"/>
        <mxCell id="erd-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="erd-layer"><mxGeometry x="0" y="0" width="5600" height="4450" as="geometry"/></mxCell>
        <mxCell id="erd-title" value="ITSI Standalone — Current PostgreSQL data model" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=32;fontStyle=1;fontColor=#17202A;" vertex="1" parent="erd-layer"><mxGeometry x="80" y="35" width="5440" height="58" as="geometry"/></mxCell>
        <mxCell id="erd-subtitle" value="Consecutive migrations 0001–0007 • compat + ea schemas • Kafka inbox/outboxes • durable Episode aliases • as of 2026-09-01" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#52616B;" vertex="1" parent="erd-layer"><mxGeometry x="80" y="98" width="5440" height="40" as="geometry"/></mxCell>
        <mxCell id="erd-invariant" value="&lt;b&gt;CORE IDENTITY INVARIANT&lt;/b&gt;  Compact surrogate IDs form physical PK/FK relationships. Canonical exact text remains authority; bounded SHA-256 indexes only narrow candidates and every equality route rechecks exact text. Known EA documents route to typed ea tables; unknown/future collections remain lossless in compat.kv_documents. Episode pages never reconstruct current state from retained HEC." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#2874A6;strokeWidth=2;align=left;verticalAlign=middle;spacing=15;fontFamily=Helvetica;fontSize=15;fontColor=#1B4F72;" vertex="1" parent="erd-layer"><mxGeometry x="80" y="155" width="5440" height="90" as="geometry"/></mxCell>

        <mxCell id="compat-boundary" value="&lt;b&gt;compat schema&lt;/b&gt;&lt;br&gt;Splunk / ITSI compatibility authorities and conventional future-capability storage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9F9;strokeColor=#566573;strokeWidth=3;align=left;verticalAlign=top;spacingTop=18;spacingLeft=22;spacingRight=14;fontFamily=Helvetica;fontSize=20;fontColor=#273746;container=1;collapsible=0;recursiveResize=0;shadow=0;" vertex="1" parent="erd-layer"><mxGeometry x="80" y="290" width="2670" height="2690" as="geometry"/></mxCell>
        <mxCell id="compat-migrations" value="&lt;b&gt;«table» schema_migrations&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; version&lt;br&gt;name • checksum_sha256 • catalog_sha256 • applied_at&lt;br&gt;&lt;br&gt;File checksum + deterministic live static-catalog attestation. Dynamic monthly children are validated separately." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2874A6;strokeWidth=2;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=12;fontColor=#17202A;" vertex="1" parent="compat-boundary"><mxGeometry x="70" y="115" width="730" height="210" as="geometry"/></mxCell>
        <mxCell id="compat-collections" value="&lt;b&gt;«table» kv_collections&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; collection_pk identity&lt;br&gt;name exact text COLLATE C • name_hash&lt;br&gt;app • config_json • updated_at&lt;br&gt;&lt;b&gt;INDEX&lt;/b&gt; kv_collections_name_hash (name_hash, collection_pk)&lt;br&gt;&lt;br&gt;Surrogate identity; hash narrows, exact name decides." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#566573;strokeWidth=2;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=11;fontColor=#17202A;" vertex="1" parent="compat-boundary"><mxGeometry x="970" y="115" width="730" height="210" as="geometry"/></mxCell>
        <mxCell id="compat-documents" value="&lt;b&gt;«table» kv_documents&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; document_pk identity&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; collection_pk → kv_collections.collection_pk ON DELETE CASCADE&lt;br&gt;document_key exact text COLLATE C • document_key_hash&lt;br&gt;document_json authority • document_jsonb? accelerator&lt;br&gt;document_bytes generated • action_queue_eligible&lt;br&gt;action_create_time_num • created_seq identity • row_version • updated_at&lt;br&gt;&lt;b&gt;INDEXES&lt;/b&gt; kv_documents_collection_key_hash&lt;br&gt;kv_documents_collection_created • kv_documents_collection_updated&lt;br&gt;kv_documents_action_queue_page WHERE action_queue_eligible&lt;br&gt;&lt;br&gt;Lossless generic/future authority; bounded metadata-first action polling." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#566573;strokeWidth=2;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=10;fontColor=#17202A;" vertex="1" parent="compat-boundary"><mxGeometry x="1870" y="115" width="730" height="330" as="geometry"/></mxCell>
        <mxCell id="compat-properties" value="&lt;b&gt;«table» properties&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; property_pk identity&lt;br&gt;conf_name • stanza • property_key exact text COLLATE C&lt;br&gt;identity_hash • stanza_scope_hash&lt;br&gt;property_json • updated_at&lt;br&gt;&lt;b&gt;INDEXES&lt;/b&gt; properties_identity_hash&lt;br&gt;properties_stanza_scope_hash" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#566573;strokeWidth=2;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=10;fontColor=#17202A;" vertex="1" parent="compat-boundary"><mxGeometry x="70" y="465" width="730" height="220" as="geometry"/></mxCell>
        <mxCell id="compat-runtime" value="&lt;b&gt;«table» runtime_values&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; value_key COLLATE C&lt;br&gt;value_json • updated_at&lt;br&gt;&lt;br&gt;Small synchronous control state." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#566573;strokeWidth=2;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=13;fontColor=#17202A;" vertex="1" parent="compat-boundary"><mxGeometry x="970" y="465" width="730" height="220" as="geometry"/></mxCell>
        <mxCell id="compat-request" value="&lt;b&gt;«partitioned table» request_log&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; recorded_at, request_id identity&lt;br&gt;method • path • query_json • headers_json • body bytea&lt;br&gt;&lt;b&gt;PARTITION&lt;/b&gt; RANGE(recorded_at)&lt;br&gt;&lt;b&gt;STATIC CHILD&lt;/b&gt; request_log_overflow DEFAULT (catalog-attested)&lt;br&gt;&lt;b&gt;DYNAMIC CHILDREN&lt;/b&gt; request_log_YYYYMM [UTC month,next month)&lt;br&gt;&lt;b&gt;INDEX&lt;/b&gt; request_log_recorded (recorded_at, request_id)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#566573;strokeWidth=2;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=10;fontColor=#17202A;" vertex="1" parent="compat-boundary"><mxGeometry x="1870" y="515" width="730" height="280" as="geometry"/></mxCell>
        <mxCell id="compat-acks" value="&lt;b&gt;«table» hec_acks&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; ack_id identity&lt;br&gt;recorded_at • expected_event_count • received_event_count&lt;br&gt;terminal • terminal_at?&lt;br&gt;&lt;b&gt;PARTIAL INDEX&lt;/b&gt; hec_acks_pending_oldest&lt;br&gt;&lt;br&gt;Durable pending → terminal HEC ACK progress. Raw rows use an indexed logical ack_id, not an FK." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#566573;strokeWidth=2;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=13;fontColor=#17202A;" vertex="1" parent="compat-boundary"><mxGeometry x="70" y="865" width="730" height="250" as="geometry"/></mxCell>
        <mxCell id="compat-hec" value="&lt;b&gt;«partitioned table» hec_events&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; recorded_at, hec_id ← hec_id_seq NO CYCLE&lt;br&gt;token? • request_channel? • ack_id? • index_name/source/sourcetype/host? • event_time_num? • snapshot_time_num?&lt;br&gt;envelope_json authority • envelope_jsonb? • missed_group_jsonb?&lt;br&gt;episode_pk? • is_aice_enabled? • cdc_type? • bdt_event_present&lt;br&gt;&lt;b&gt;EXACT + SHA-256&lt;/b&gt; group_id/group_id_hash • event_id/event_id_key/event_id_hash&lt;br&gt;event_identifier_string/event_identifier_key/event_identifier_hash&lt;br&gt;policy_key/policy_exact_key/policy_exact_hash • index_exact_key/index_exact_hash&lt;br&gt;group_count_num? • last_event_time_num? • first_event_time_num? • earliest_event_time_num?&lt;br&gt;is_last_event_text? • canonical_projection_complete • grouped_output_application?&lt;br&gt;&lt;b&gt;PARTITION&lt;/b&gt; RANGE(recorded_at)&lt;br&gt;&lt;b&gt;STATIC CHILD&lt;/b&gt; hec_events_overflow DEFAULT (catalog-attested)&lt;br&gt;&lt;b&gt;DYNAMIC CHILDREN&lt;/b&gt; hec_events_YYYYMM [UTC month,next month)&lt;br&gt;&lt;b&gt;INDEXES&lt;/b&gt; hec_events_id • hec_events_recorded • hec_events_ack • hec_events_episode&lt;br&gt;hec_events_event_id_hash • hec_events_index_hash_time • hec_events_aice_group_latest&lt;br&gt;hec_events_aice_policy_group_latest • hec_events_group_event_time&lt;br&gt;hec_events_group_snapshot_time • hec_events_index_exact_time&lt;br&gt;hec_events_severity_restore • hec_events_cache_time • hec_events_episode_applied_member&lt;br&gt;&lt;br&gt;Every packaged output is audit evidence; application = applied | duplicate | conflict gates canonical projection." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#B03A2E;strokeWidth=2;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=9;fontColor=#641E16;" vertex="1" parent="compat-boundary"><mxGeometry x="970" y="865" width="1630" height="550" as="geometry"/></mxCell>
        <mxCell id="compat-search" value="&lt;b&gt;«table» search_jobs&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; sid COLLATE C&lt;br&gt;created_at • query_text • plan_name • state&lt;br&gt;&lt;br&gt;Fixed-plan metadata; result_count is derived from result rows." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#566573;strokeWidth=2;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=13;fontColor=#17202A;" vertex="1" parent="compat-boundary"><mxGeometry x="70" y="1450" width="730" height="230" as="geometry"/></mxCell>
        <mxCell id="compat-results" value="&lt;b&gt;«table» search_job_results&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK/FK&lt;/b&gt; sid, ordinal → search_jobs.sid&lt;br&gt;result_json&lt;br&gt;&lt;br&gt;Ordered immutable rows; cascade-delete with job.&lt;br&gt;Retrieval: ordinal offset + optional positive count/LIMIT.&lt;br&gt;count=0 returns the admitted remainder; this is not streaming." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#566573;strokeWidth=2;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=13;fontColor=#17202A;" vertex="1" parent="compat-boundary"><mxGeometry x="970" y="1450" width="730" height="280" as="geometry"/></mxCell>
        <mxCell id="compat-function" value="&lt;b&gt;«functions»&lt;/b&gt;&lt;br&gt;&lt;b&gt;finite_float(text)&lt;/b&gt; — finite numeric extraction&lt;br&gt;&lt;b&gt;compact_jsonb_octet_length(jsonb)&lt;/b&gt; — compact wire-byte count&lt;br&gt;Both are immutable and parallel-safe.&lt;br&gt;&lt;br&gt;&lt;b&gt;Catalog attestor&lt;/b&gt;&lt;br&gt;Static catalog SHA includes DEFAULT partitions; named monthly children are excluded and bound-validated separately." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#2874A6;strokeWidth=2;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=11;fontColor=#1B4F72;" vertex="1" parent="compat-boundary"><mxGeometry x="1870" y="1450" width="730" height="200" as="geometry"/></mxCell>
        <mxCell id="compat-note" value="&lt;b&gt;Surrogate + hash + exact identity rule&lt;/b&gt;&lt;br&gt;Unbounded caller/vendor values are canonical ASCII JSON-string text under bytewise COLLATE C and never B-tree keys. Surrogate IDs form PK/FK relationships. SHA-256 indexes narrow candidates; advisory-lock serialization plus complete exact-text recheck decides identity. A digest collision cannot equate values. Canonical JSON text remains authority; JSONB/typed projections are nullable accelerators. Required incomplete fixed-search projections fail visibly—never silent omission." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#C25700;strokeWidth=2;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=14;fontColor=#873600;" vertex="1" parent="compat-boundary"><mxGeometry x="70" y="1810" width="2530" height="250" as="geometry"/></mxCell>
        <mxCell id="compat-hot-note" value="&lt;b&gt;All-hot partition availability&lt;/b&gt;&lt;br&gt;DEFAULT overflow children accept writes when the monthly horizon is missed. Bootstrap and the persistent daily timer transactionally create UTC-month children and move matching overflow rows; they never delete general application history. Kafka connector terminal evidence alone has a bounded, configurable retention cleanup. There is no cold/archive tier, automatic data transfer, or SQLite fallback." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=2;dashed=1;dashPattern=8 5;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=14;fontColor=#273746;" vertex="1" parent="compat-boundary"><mxGeometry x="70" y="2160" width="2530" height="190" as="geometry"/></mxCell>
        <mxCell id="compat-index-note" value="&lt;b&gt;History independence + fixed-search safety envelope&lt;/b&gt;&lt;br&gt;Episode lists/totals never scan raw HEC; Episode detail alone uses (episode_pk, hec_id DESC). Hash-indexed SQL selects each recognized high-volume fixed family and rechecks exact keys. SQL source preflight and transactional shaped-result prefixes share admission defaults: 250,000 rows + 256 MiB; valid 1–10,000,000 rows + 1 MiB–1 GiB. Over budget fails visibly and rolls back a partial job. Admitted source rows and shaped results can coexist in Python memory. Ordinal offset/optional count pages stored results; count=0 returns the remainder—neither path is streaming." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#2874A6;strokeWidth=2;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=13;fontColor=#1B4F72;" vertex="1" parent="compat-boundary"><mxGeometry x="70" y="2400" width="2530" height="260" as="geometry"/></mxCell>

        <mxCell id="ea-boundary" value="&lt;b&gt;ea schema&lt;/b&gt;&lt;br&gt;Typed Event Analytics authorities and history-independent serving projections" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8F1;strokeColor=#C25700;strokeWidth=3;align=left;verticalAlign=top;spacingTop=18;spacingLeft=22;spacingRight=14;fontFamily=Helvetica;fontSize=20;fontColor=#873600;container=1;collapsible=0;recursiveResize=0;shadow=0;" vertex="1" parent="erd-layer"><mxGeometry x="2870" y="290" width="2650" height="2690" as="geometry"/></mxCell>
        <mxCell id="ea-neap" value="&lt;b&gt;«table» neap_policies&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; policy_pk identity&lt;br&gt;external_key exact text COLLATE C • external_key_hash&lt;br&gt;document_json authority • document_jsonb? accelerator&lt;br&gt;policy_kind? • title? • mod_time_num? • disabled?&lt;br&gt;object_type? • priority_num? • created_seq identity&lt;br&gt;row_version • updated_at&lt;br&gt;&lt;b&gt;INDEXES&lt;/b&gt; neap_policies_external_key_hash&lt;br&gt;neap_policies_created&lt;br&gt;&lt;br&gt;Rules/matchers remain opaque package-owned JSON." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8F1;strokeColor=#C25700;strokeWidth=2;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=10;fontColor=#633000;" vertex="1" parent="ea-boundary"><mxGeometry x="70" y="115" width="750" height="330" as="geometry"/></mxCell>
        <mxCell id="ea-notable" value="&lt;b&gt;«table» notable_events&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; notable_pk identity&lt;br&gt;external_key exact text COLLATE C • external_key_hash&lt;br&gt;document_json authority • document_jsonb? • created_seq identity&lt;br&gt;created_at • updated_at • event_time_num?&lt;br&gt;time_sort_rank • time_sort_num? • time_sort_text&lt;br&gt;time_sort_bytes bytea — surrogatepass/NUL ordering authority; intentionally unindexed&lt;br&gt;page_eligible • nested_event_bytes • source? • host? • severity_code? • matcher_name?&lt;br&gt;event_id/event_id_key/event_id_hash • raw_group_id/raw_group_id_hash • is_admin_event?&lt;br&gt;canonical_projection_complete • row_version&lt;br&gt;&lt;b&gt;INDEXES&lt;/b&gt; notable_events_external_key_hash • notable_events_page • notable_events_created&lt;br&gt;notable_events_time_compat • notable_events_raw_group • notable_events_event_id_hash&lt;br&gt;&lt;br&gt;Typed tracked-Notable authority; required incomplete projection fails closed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8F1;strokeColor=#B03A2E;strokeWidth=2;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=9;fontColor=#641E16;" vertex="1" parent="ea-boundary"><mxGeometry x="950" y="115" width="750" height="420" as="geometry"/></mxCell>
        <mxCell id="ea-counts" value="&lt;b&gt;«table» count_shards&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; family, dimension_kind,&lt;br&gt;dimension_value, shard&lt;br&gt;16 active shards • DDL reserves [0, 63]&lt;br&gt;exact_count • updated_at&lt;br&gt;&lt;br&gt;Fixed-shard exact Episode/severity/Notable/source totals; 0002 backfills Episode source counts." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8F1;strokeColor=#C25700;strokeWidth=2;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=13;fontColor=#633000;" vertex="1" parent="ea-boundary"><mxGeometry x="1830" y="115" width="750" height="280" as="geometry"/></mxCell>
        <mxCell id="ea-sources" value="&lt;b&gt;«table» episode_source_current&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK/FK&lt;/b&gt; episode_pk, source_kind → episode_identity&lt;br&gt;source_kind = system | user | hec&lt;br&gt;source_json authority • source_jsonb? • latest_hec_id? logical reference&lt;br&gt;cumulative_member_count • maximum_observed_num? • similarity_time_num?&lt;br&gt;active_flag? • policy_key? • policy_exact_key COLLATE C • policy_exact_hash&lt;br&gt;mod_time_num? • start_time_num? • canonical_projection_complete&lt;br&gt;source_version • updated_at&lt;br&gt;&lt;b&gt;PARTIAL INDEXES&lt;/b&gt; episode_source_active_policy_start&lt;br&gt;episode_source_active_mod_time&lt;br&gt;&lt;br&gt;At most three rows per Episode; incomplete policy-filtered AICE fails closed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8F1;strokeColor=#B03A2E;strokeWidth=2;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=9;fontColor=#641E16;" vertex="1" parent="ea-boundary"><mxGeometry x="70" y="600" width="750" height="410" as="geometry"/></mxCell>
        <mxCell id="ea-identity" value="&lt;b&gt;«table» episode_identity&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; episode_pk identity&lt;br&gt;external_key exact text COLLATE C • key_hash&lt;br&gt;episode_sort_prefix bytea • sort_overflow&lt;br&gt;created_seq identity • row_version • active • updated_at&lt;br&gt;&lt;b&gt;UNIQUE&lt;/b&gt; episode_identity_key_hash_unique (key_hash)&lt;br&gt;&lt;b&gt;INDEX&lt;/b&gt; episode_identity_hash (key_hash, episode_pk)&lt;br&gt;&lt;br&gt;Unique bounded hash serializes creation; exact key recheck remains authoritative." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8F1;strokeColor=#C25700;strokeWidth=2;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=10;fontColor=#633000;" vertex="1" parent="ea-boundary"><mxGeometry x="950" y="600" width="750" height="290" as="geometry"/></mxCell>
        <mxCell id="ea-current" value="&lt;b&gt;«table» episode_current&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK/FK&lt;/b&gt; episode_pk → episode_identity&lt;br&gt;external_key exact text COLLATE C • episode_sort_prefix • sort_overflow&lt;br&gt;last_observed_num? • effective_severity_code? • effective_status? • effective_owner? • active&lt;br&gt;policy_key? • title? • description? • summary_json authority&lt;br&gt;cumulative_member_count • projection_version • presentation_hash • updated_at&lt;br&gt;&lt;b&gt;PARTIAL INDEXES (active)&lt;/b&gt; episode_current_recent • episode_current_oldest&lt;br&gt;episode_current_severity • episode_current_lookback&lt;br&gt;&lt;br&gt;Indexed effective serving row; summary_json can be wide; no raw-history FK." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#B03A2E;strokeWidth=2;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=9;fontColor=#641E16;" vertex="1" parent="ea-boundary"><mxGeometry x="1830" y="600" width="750" height="400" as="geometry"/></mxCell>
        <mxCell id="ea-episode-view" value="&lt;b&gt;«view» episode_api_v&lt;/b&gt;&lt;br&gt;episode_pk • external_key • last_observed_num • effective_severity_code&lt;br&gt;effective_status • effective_owner • active • policy_key • title • description&lt;br&gt;summary_json • cumulative_member_count • episode_sort_prefix • sort_overflow • updated_at&lt;br&gt;&lt;br&gt;Stable, non-owning API projection over episode_current." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#2874A6;strokeWidth=2;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=9;fontColor=#1B4F72;" vertex="1" parent="ea-boundary"><mxGeometry x="420" y="1140" width="750" height="220" as="geometry"/></mxCell>
        <mxCell id="ea-notable-view" value="&lt;b&gt;«view» notable_api_v&lt;/b&gt;&lt;br&gt;notable_pk • external_key • document_json • created_seq • event_time_num&lt;br&gt;page_eligible • nested_event_bytes • event_id • source • host&lt;br&gt;severity_code • matcher_name • updated_at&lt;br&gt;&lt;br&gt;Stable, non-owning API projection over notable_events." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#2874A6;strokeWidth=2;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=9;fontColor=#1B4F72;" vertex="1" parent="ea-boundary"><mxGeometry x="1480" y="1140" width="750" height="220" as="geometry"/></mxCell>
        <mxCell id="ea-transaction-note" value="&lt;b&gt;Atomic projection rule&lt;/b&gt;&lt;br&gt;Known EA mutations persist the canonical authority, resolve Episode identity, update affected source rows, recompute one effective Episode row, and apply exact count movement in a PostgreSQL transaction. Committed current state is visible before the response is returned." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#C25700;strokeWidth=2;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=14;fontColor=#873600;" vertex="1" parent="ea-boundary"><mxGeometry x="70" y="1430" width="2510" height="220" as="geometry"/></mxCell>
        <mxCell id="ea-read-note" value="&lt;b&gt;Bounded read paths&lt;/b&gt;&lt;br&gt;Episode page: indexed episode_current. All-time/severity totals: count_shards. Finite lookback: indexed current rows. Notable page: typed notable_events. Episode detail alone reads retained compat.hec_events. Every recognized high-volume fixed family uses typed/hash-indexed SQL source selection, exact canonical-key recheck, fail-closed required projections, and hard result-admission budgets. Admitted source and shaped lists can still coexist in Python memory." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=2;dashed=1;dashPattern=8 5;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=14;fontColor=#273746;" vertex="1" parent="ea-boundary"><mxGeometry x="70" y="1750" width="2510" height="190" as="geometry"/></mxCell>
        <mxCell id="ea-package-note" value="&lt;b&gt;Semantics boundary&lt;/b&gt;&lt;br&gt;The unchanged packaged `.spl` owns matching, grouping, breaking, transitions, and action activation. PostgreSQLStore persists, indexes, and mechanically projects those outputs; it does not reproduce vendor decision logic." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#7F8C8D;strokeWidth=2;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=14;fontColor=#273746;" vertex="1" parent="ea-boundary"><mxGeometry x="70" y="2040" width="2510" height="190" as="geometry"/></mxCell>
        <mxCell id="ea-deferred-note" value="&lt;b&gt;Still deferred&lt;/b&gt;&lt;br&gt;No asynchronous HTTP grouping-result API, Episode vertical split, normalized Notable blob store, typed action tables, or general application-history retention. Fixed-search streaming/cancellation, measured COPY/set staging, production-cardinality plans and 72-hour Kafka/engine soak remain open. The Kafka path now closes admission→NATS and grouped-output→Kafka crash gaps with durable receipts and outboxes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=2;dashed=1;dashPattern=8 5;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=14;fontColor=#273746;" vertex="1" parent="ea-boundary"><mxGeometry x="70" y="2330" width="2510" height="180" as="geometry"/></mxCell>

        <mxCell id="rel-collection-documents" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#566573;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="erd-layer" source="compat-collections" target="compat-documents"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-search-results" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#566573;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="erd-layer" source="compat-search" target="compat-results"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-ack-hec" value="indexed ack_id • no FK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=8 5;endArrow=open;endFill=0;strokeColor=#7D3C98;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#512E5F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.35;" edge="1" parent="erd-layer" source="compat-acks" target="compat-hec"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-identity-source" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#C25700;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="erd-layer" source="ea-identity" target="ea-sources"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-identity-current" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERzeroToOne;endFill=0;strokeColor=#C25700;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="erd-layer" source="ea-identity" target="ea-current"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-hec-identity" value="indexed episode_pk • no FK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=8 5;endArrow=open;endFill=0;strokeColor=#7D3C98;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#512E5F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.72;entryX=0.5;entryY=1;" edge="1" parent="erd-layer" source="compat-hec" target="ea-identity"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2810" y="1330"/><mxPoint x="4195" y="1330"/></Array></mxGeometry></mxCell>
        <mxCell id="rel-source-current" value="effective overlay" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=8 5;endArrow=open;endFill=0;strokeColor=#7D3C98;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#512E5F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="erd-layer" source="ea-sources" target="ea-current"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3315" y="1370"/><mxPoint x="5075" y="1370"/></Array></mxGeometry></mxCell>
        <mxCell id="rel-neap-current" value="soft policy_key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=8 5;endArrow=open;endFill=0;strokeColor=#7D3C98;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#512E5F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="erd-layer" source="ea-neap" target="ea-current"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3315" y="840"/><mxPoint x="4840" y="840"/></Array></mxGeometry></mxCell>
        <mxCell id="rel-current-count" value="exact deltas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=8 5;endArrow=open;endFill=0;strokeColor=#7D3C98;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#512E5F;labelBackgroundColor=#FFFFFF;exitX=0.85;exitY=0;entryX=0.85;entryY=1;" edge="1" parent="erd-layer" source="ea-current" target="ea-counts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-notable-count" value="exact deltas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=8 5;endArrow=open;endFill=0;strokeColor=#7D3C98;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#512E5F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="erd-layer" source="ea-notable" target="ea-counts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-current-view" value="view projection" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=8 5;endArrow=open;endFill=0;strokeColor=#2874A6;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#1B4F72;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="erd-layer" source="ea-current" target="ea-episode-view"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4840" y="1380"/><mxPoint x="4040" y="1380"/></Array></mxGeometry></mxCell>
        <mxCell id="rel-notable-view" value="view projection" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=8 5;endArrow=open;endFill=0;strokeColor=#2874A6;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#1B4F72;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="erd-layer" source="ea-notable" target="ea-notable-view"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="kafka-boundary" value="&lt;b&gt;Kafka connector durability boundary (optional; OPENITSI_KAFKA_CONNECTOR_MODE=all)&lt;/b&gt;&lt;br&gt;Generic Open-ITSI Notables enter from Kafka; grouped packaged-engine output creates generic Episode membership events. PostgreSQL is the crash-safe hand-off on both sides." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5FAFE;strokeColor=#2874A6;strokeWidth=3;align=left;verticalAlign=top;spacingTop=18;spacingLeft=22;spacingRight=14;fontFamily=Helvetica;fontSize=20;fontColor=#1B4F72;container=1;collapsible=0;recursiveResize=0;shadow=0;" vertex="1" parent="erd-layer"><mxGeometry x="80" y="3050" width="5440" height="950" as="geometry"/></mxCell>
        <mxCell id="kafka-receipts" value="&lt;b&gt;«table» compat.kafka_ingress_receipts&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; ingress_id identity&lt;br&gt;&lt;b&gt;UNIQUE&lt;/b&gt; topic + partition + offset&lt;br&gt;&lt;b&gt;UNIQUE&lt;/b&gt; message_identity_hash • event_id_hash&lt;br&gt;tenant_id • message_id • event_id&lt;br&gt;content_digest • notable_digest&lt;br&gt;envelope_json authority • envelope_jsonb?&lt;br&gt;notable_json authority • notable_jsonb?&lt;br&gt;status accepted | nats_published&lt;br&gt;NATS sequence + duplicate evidence" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2874A6;strokeWidth=2;align=left;verticalAlign=top;spacing=13;fontFamily=Helvetica;fontSize=11;fontColor=#17202A;" vertex="1" parent="kafka-boundary"><mxGeometry x="70" y="115" width="830" height="300" as="geometry"/></mxCell>
        <mxCell id="kafka-rejections" value="&lt;b&gt;«table» compat.kafka_ingress_rejections&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; rejection_id identity&lt;br&gt;&lt;b&gt;UNIQUE&lt;/b&gt; topic + partition + offset&lt;br&gt;error_code • bounded error_detail&lt;br&gt;full-value SHA-256 • raw_value_bytes&lt;br&gt;bounded raw_value preview • rejected_at&lt;br&gt;&lt;br&gt;A durable rejection permits the consumer offset to advance without an infinite poison-message loop." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8F1;strokeColor=#C25700;strokeWidth=2;align=left;verticalAlign=top;spacing=13;fontFamily=Helvetica;fontSize=11;fontColor=#633000;" vertex="1" parent="kafka-boundary"><mxGeometry x="970" y="115" width="830" height="300" as="geometry"/></mxCell>
        <mxCell id="kafka-nats-outbox" value="&lt;b&gt;«table» compat.kafka_nats_outbox&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; outbox_id identity&lt;br&gt;&lt;b&gt;FK/UNIQUE&lt;/b&gt; ingress_id → receipts&lt;br&gt;&lt;b&gt;UNIQUE&lt;/b&gt; stable nats_message_id&lt;br&gt;notable_json authority • notable_jsonb?&lt;br&gt;pending | in_flight | published&lt;br&gt;attempts • retry time • lease token/deadline&lt;br&gt;last_error • PubAck stream sequence&lt;br&gt;&lt;br&gt;Claims preserve Kafka partition/offset order." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2874A6;strokeWidth=2;align=left;verticalAlign=top;spacing=13;fontFamily=Helvetica;fontSize=11;fontColor=#17202A;" vertex="1" parent="kafka-boundary"><mxGeometry x="1870" y="115" width="830" height="300" as="geometry"/></mxCell>
        <mxCell id="kafka-membership" value="&lt;b&gt;«table» ea.kafka_episode_membership&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK/FK&lt;/b&gt; ingress_id → receipts&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; episode_pk → episode_identity&lt;br&gt;semantic_digest • first_hec_id • created_at&lt;br&gt;&lt;br&gt;One admitted Kafka Notable may join exactly one tenant-scoped Episode. Replayed HEC is audit evidence but cannot inflate membership; reassignment is a conflict." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8F1;strokeColor=#C25700;strokeWidth=2;align=left;verticalAlign=top;spacing=13;fontFamily=Helvetica;fontSize=11;fontColor=#633000;" vertex="1" parent="kafka-boundary"><mxGeometry x="2770" y="115" width="830" height="300" as="geometry"/></mxCell>
        <mxCell id="kafka-episode-outbox" value="&lt;b&gt;«table» compat.kafka_episode_outbox&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; outbox_id identity&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; episode_pk • ingress_id&lt;br&gt;&lt;b&gt;UNIQUE&lt;/b&gt; message_id • ingress_id + event_type&lt;br&gt;tenant_id • partition_key&lt;br&gt;payload_json authority • payload_jsonb&lt;br&gt;pending | in_flight | published&lt;br&gt;retry/lease/error • Kafka partition/offset&lt;br&gt;&lt;br&gt;Claims serialize each Episode partition key." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2874A6;strokeWidth=2;align=left;verticalAlign=top;spacing=13;fontFamily=Helvetica;fontSize=11;fontColor=#17202A;" vertex="1" parent="kafka-boundary"><mxGeometry x="3670" y="115" width="830" height="300" as="geometry"/></mxCell>
        <mxCell id="kafka-conflicts" value="&lt;b&gt;«table» compat.kafka_projection_conflicts&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; conflict_id identity&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; ingress_id&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; existing + attempted episode_pk&lt;br&gt;attempted_hec_id • conflict_code • recorded_at&lt;br&gt;&lt;br&gt;Durable evidence when one immutable admitted Notable is later presented as a member of another Episode." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#B03A2E;strokeWidth=2;align=left;verticalAlign=top;spacing=13;fontFamily=Helvetica;fontSize=11;fontColor=#641E16;" vertex="1" parent="kafka-boundary"><mxGeometry x="4570" y="115" width="800" height="300" as="geometry"/></mxCell>
        <mxCell id="kafka-transaction-note" value="&lt;b&gt;Atomic boundaries&lt;/b&gt;  Kafka receipt + local NATS outbox commit before the input offset is acknowledged. After NATS PubAck, the tracked-Notable checkpoint and receipt are updated atomically. Grouped HEC application + immutable membership + Episode event outbox commit together; Kafka delivery is retried independently with a stable message id." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#2874A6;strokeWidth=2;align=left;verticalAlign=middle;spacing=15;fontFamily=Helvetica;fontSize=14;fontColor=#1B4F72;" vertex="1" parent="kafka-boundary"><mxGeometry x="70" y="500" width="5300" height="145" as="geometry"/></mxCell>
        <mxCell id="kafka-retention-note" value="&lt;b&gt;Finite terminal evidence retention&lt;/b&gt;  A lifecycle-owned maintenance worker deletes only terminal, aged connector evidence in bounded FK-safe batches. Pending/in-flight work, unresolved conflicts, canonical Episode/Notable projections, and packaged HEC history are never removed by this connector cleanup." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#C25700;strokeWidth=2;align=left;verticalAlign=middle;spacing=15;fontFamily=Helvetica;fontSize=14;fontColor=#873600;" vertex="1" parent="kafka-boundary"><mxGeometry x="70" y="700" width="5300" height="140" as="geometry"/></mxCell>
        <mxCell id="rel-kafka-receipt-nats" value="durable delivery" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#2874A6;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontColor=#1B4F72;labelBackgroundColor=#FFFFFF;" edge="1" parent="kafka-boundary" source="kafka-receipts" target="kafka-nats-outbox"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-kafka-receipt-membership" value="idempotent projection" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#C25700;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontColor=#873600;labelBackgroundColor=#FFFFFF;" edge="1" parent="kafka-boundary" source="kafka-receipts" target="kafka-membership"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-kafka-membership-outbox" value="same transaction" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#2874A6;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontColor=#1B4F72;labelBackgroundColor=#FFFFFF;" edge="1" parent="kafka-boundary" source="kafka-membership" target="kafka-episode-outbox"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="erd-runtime-note" value="&lt;b&gt;Runtime + lifecycle ownership&lt;/b&gt;  PostgreSQLStore owns application reads/writes. db_admin + schema_catalog own migration/catalog attestation and dynamic partition preparation; staging installs a persistent daily mover. The optional embedded Kafka connector is started only after the Standalone HTTP socket binds and drains before NATS/store shutdown. API, UI, MCP, Kafka, NATS, and packaged Java never connect to PostgreSQL directly." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#7F8C8D;strokeWidth=2;align=left;verticalAlign=middle;spacing=15;fontFamily=Helvetica;fontSize=14;fontColor=#273746;" vertex="1" parent="erd-layer"><mxGeometry x="80" y="4100" width="5440" height="95" as="geometry"/></mxCell>
        <mxCell id="erd-legend" value="&lt;b&gt;Legend&lt;/b&gt;  Gray = compatibility authority  •  Orange = typed Event Analytics authority  •  Blue = stable API / transport durability  •  Red outline = high-volume hot path or conflict evidence  •  Solid crow-foot = PostgreSQL FK  •  Dashed purple arrow = application-managed dependency / indexed logical reference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=2;align=left;verticalAlign=middle;spacing=15;fontFamily=Helvetica;fontSize=14;fontColor=#273746;" vertex="1" parent="erd-layer"><mxGeometry x="80" y="4250" width="5440" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
