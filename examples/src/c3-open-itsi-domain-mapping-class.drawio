        <mxCell id="n-mode-note" value="&lt;b&gt;Runtime behavior remains explicit&lt;/b&gt;&lt;br&gt;&lt;b&gt;native&lt;/b&gt; — no Open-ITSI publication; current C3 rules remain unchanged. &lt;b&gt;open_itsi&lt;/b&gt; — publish Notables and consume allowlisted Episode membership results. Every generated C3 NEAP split starts with &lt;b&gt;tenant_id&lt;/b&gt;, so different tenants never share an Episode." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F1;strokeColor=#C25700;strokeWidth=2;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=16;fontColor=#633000;" vertex="1" parent="n1"><mxGeometry x="100" y="1970" width="4000" height="150" as="geometry"/></mxCell>
        <mxCell id="n-omitted" value="&lt;b&gt;Not projected:&lt;/b&gt; eventTime • firstRaisedTime • lastRaisedTime • deepLink • region • entityType/entityId • canvasMetadata • LLM fields • RBAC fields. isDeleted is a submission eligibility concern, not a Notable field. &lt;b&gt;Removed:&lt;/b&gt; c3_grouping_key and c3_notification_version." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#7F8C8D;strokeWidth=2;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=15;fontColor=#34495E;" vertex="1" parent="n1"><mxGeometry x="100" y="2150" width="4000" height="120" as="geometry"/></mxCell>
