        <mxCell id="e-title" value="Open-ITSI Episode Membership → C3 Incident" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=38;fontStyle=1;fontColor=#17202A;" vertex="1" parent="e1"><mxGeometry x="80" y="32" width="4040" height="58" as="geometry"/></mxCell>
        <mxCell id="e-subtitle" value="Open-ITSI is the membership authority; C3 remains the Incident persistence, classification and lifecycle authority" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#34495E;" vertex="1" parent="e1"><mxGeometry x="80" y="94" width="4040" height="42" as="geometry"/></mxCell>
        <mxCell id="e-legend" value="&lt;b&gt;Legend&lt;/b&gt;  Teal solid = direct • Orange dashed = derived • Gray dashed = validated/observed but not persisted • Blue = C3-owned projection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#7F8C8D;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=15;fontColor=#34495E;" vertex="1" parent="e1"><mxGeometry x="580" y="160" width="3040" height="72" as="geometry"/></mxCell>

        <mxCell id="e-open" value="&lt;i&gt;«Kafka egress contract»&lt;/i&gt;&lt;br&gt;&lt;b&gt;OpenItsiEpisodeEvent&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;Append-only Episode membership delta&lt;/font&gt;" style="swimlane;horizontal=1;startSize=120;container=1;collapsible=0;recursiveResize=0;rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F8F5;swimlaneFillColor=#D5F5E3;strokeColor=#148F77;strokeWidth=3;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#17202A;" vertex="1" parent="e1"><mxGeometry x="100" y="310" width="1240" height="1290" as="geometry"/></mxCell>
        <mxCell id="e-open-fields" value="&lt;div style=&quot;height:90px;line-height:90px;border-bottom:1px solid #A2D9CE;&quot;&gt;schema_version&lt;/div&gt;&lt;div style=&quot;height:90px;line-height:90px;border-bottom:1px solid #A2D9CE;&quot;&gt;message_id&lt;/div&gt;&lt;div style=&quot;height:90px;line-height:90px;border-bottom:1px solid #A2D9CE;&quot;&gt;event_type&lt;/div&gt;&lt;div style=&quot;height:90px;line-height:90px;border-bottom:1px solid #A2D9CE;&quot;&gt;emitted_at&lt;/div&gt;&lt;div style=&quot;height:90px;line-height:90px;border-bottom:1px solid #A2D9CE;&quot;&gt;scope.tenant_id&lt;/div&gt;&lt;div style=&quot;height:90px;line-height:90px;border-bottom:1px solid #A2D9CE;&quot;&gt;episode.episode_id&lt;/div&gt;&lt;div style=&quot;height:90px;line-height:90px;border-bottom:1px solid #A2D9CE;&quot;&gt;episode.policy_id&lt;/div&gt;&lt;div style=&quot;height:90px;line-height:90px;border-bottom:1px solid #A2D9CE;&quot;&gt;episode.revision&lt;/div&gt;&lt;div style=&quot;height:90px;line-height:90px;border-bottom:1px solid #A2D9CE;&quot;&gt;episode.member_count&lt;/div&gt;&lt;div style=&quot;height:90px;line-height:90px;border-bottom:1px solid #A2D9CE;&quot;&gt;membership.event_id&lt;/div&gt;&lt;div style=&quot;height:90px;line-height:90px;border-bottom:1px solid #A2D9CE;&quot;&gt;membership.source_message_id&lt;/div&gt;&lt;div style=&quot;height:90px;line-height:90px;border-bottom:1px solid #A2D9CE;&quot;&gt;membership.source_content_digest&lt;/div&gt;&lt;div style=&quot;height:90px;line-height:90px;&quot;&gt;provenance.grouped_hec_id&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=24;spacingRight=18;fontFamily=Menlo;fontSize=16;fontColor=#17202A;" vertex="1" parent="e-open"><mxGeometry x="0" y="120" width="1240" height="1170" as="geometry"/></mxCell>

        <mxCell id="e-c3" value="&lt;i&gt;«ingestion disposition + persisted fields»&lt;/i&gt;&lt;br&gt;&lt;b&gt;C3 Incident Mapping&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1B4F72&quot;&gt;One decision for every egress field&lt;/font&gt;" style="swimlane;horizontal=1;startSize=120;container=1;collapsible=0;recursiveResize=0;rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2F8;swimlaneFillColor=#D6EAF8;strokeColor=#2874A6;strokeWidth=3;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#17202A;" vertex="1" parent="e1"><mxGeometry x="2860" y="310" width="1240" height="1290" as="geometry"/></mxCell>
        <mxCell id="e-c3-fields" value="&lt;div style=&quot;height:90px;line-height:90px;border-bottom:1px solid #A9CCE3;color:#566573;&quot;&gt;∅ validate contract version&lt;/div&gt;&lt;div style=&quot;height:90px;line-height:90px;border-bottom:1px solid #A9CCE3;color:#566573;&quot;&gt;∅ transport/outbox identity&lt;/div&gt;&lt;div style=&quot;height:90px;line-height:90px;border-bottom:1px solid #A9CCE3;color:#566573;&quot;&gt;∅ route contract event&lt;/div&gt;&lt;div style=&quot;height:90px;line-height:90px;border-bottom:1px solid #A9CCE3;color:#566573;&quot;&gt;∅ observability timestamp&lt;/div&gt;&lt;div style=&quot;height:90px;line-height:90px;border-bottom:1px solid #A9CCE3;&quot;&gt;Incident.tenantId&lt;/div&gt;&lt;div style=&quot;height:90px;line-height:90px;border-bottom:1px solid #A9CCE3;&quot;&gt;Incident.aggregationKey&lt;/div&gt;&lt;div style=&quot;height:90px;line-height:90px;border-bottom:1px solid #A9CCE3;&quot;&gt;Incident.aggregationRuleId&lt;/div&gt;&lt;div style=&quot;height:90px;line-height:90px;border-bottom:1px solid #A9CCE3;color:#566573;&quot;&gt;∅ currently ignored&lt;/div&gt;&lt;div style=&quot;height:90px;line-height:90px;border-bottom:1px solid #A9CCE3;color:#566573;&quot;&gt;∅ reconstruct from membership deltas&lt;/div&gt;&lt;div style=&quot;height:90px;line-height:90px;border-bottom:1px solid #A9CCE3;&quot;&gt;Notification lookup → NotificationIncident.notificationId&lt;/div&gt;&lt;div style=&quot;height:90px;line-height:90px;border-bottom:1px solid #A9CCE3;&quot;&gt;event and message identity consistency guard&lt;/div&gt;&lt;div style=&quot;height:90px;line-height:90px;border-bottom:1px solid #A9CCE3;color:#566573;&quot;&gt;∅ schema validation only&lt;/div&gt;&lt;div style=&quot;height:90px;line-height:90px;color:#566573;&quot;&gt;∅ diagnostics only&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=24;spacingRight=18;fontFamily=Menlo;fontSize=15;fontColor=#17202A;" vertex="1" parent="e-c3"><mxGeometry x="0" y="120" width="1240" height="1170" as="geometry"/></mxCell>

