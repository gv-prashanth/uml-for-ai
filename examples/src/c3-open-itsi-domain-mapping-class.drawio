        <mxCell id="e-owned" value="&lt;i&gt;«persisted aggregate»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Incident fields owned and recomputed by C3&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; = database UUID • &lt;b&gt;source&lt;/b&gt; = rule_based • &lt;b&gt;title / description / tags&lt;/b&gt; = Incident classifier or single-Notification fallback&lt;br&gt;&lt;b&gt;severity&lt;/b&gt; = maximum linked Notification severity • &lt;b&gt;status&lt;/b&gt; = linked Notification rollup • &lt;b&gt;earliest / latest / lastUpdated&lt;/b&gt; = linked Notification timestamps&lt;br&gt;&lt;b&gt;assignee / dismiss / resolve / version / deletedAt&lt;/b&gt; = C3 lifecycle and concurrency state" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#2874A6;strokeWidth=3;align=left;verticalAlign=middle;spacing=22;fontFamily=Helvetica;fontSize=17;fontColor=#17202A;" vertex="1" parent="e1"><mxGeometry x="740" y="1740" width="2720" height="310" as="geometry"/></mxCell>
        <mxCell id="e-owned-edge" value="membership triggers C3 lookup, classification, rollup and persistence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=none;endArrow=open;endFill=0;dashed=1;dashPattern=7 5;strokeColor=#2874A6;strokeWidth=2.5;fontFamily=Helvetica;fontSize=15;fontColor=#1B4F72;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="e1" source="e-c3" target="e-owned"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-boundary-note" value="&lt;b&gt;Boundary:&lt;/b&gt; the Kafka Episode contract carries membership identity, tenant and winning policy—not final Incident wording or lifecycle. C3 reconstructs durable membership from deltas and remains authoritative for its database row." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F1;strokeColor=#C25700;strokeWidth=2;align=center;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#633000;" vertex="1" parent="e1"><mxGeometry x="420" y="2110" width="3360" height="130" as="geometry"/></mxCell>
        <mxCell id="r1" value="" style="group;" vertex="1" connectable="0" parent="n1"><mxGeometry y="4800" width="4200" height="2400" as="geometry"/></mxCell>
        <mxCell id="r-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="r1"><mxGeometry width="4200" height="2400" as="geometry"/></mxCell>
        <mxCell id="r-title" value="C3 Incident-Creation Rules → Default Open-ITSI NEAPs" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=38;fontStyle=1;fontColor=#17202A;" vertex="1" parent="r1"><mxGeometry x="80" y="32" width="4040" height="58" as="geometry"/></mxCell>
        <mxCell id="r-subtitle" value="Same C3 rule names and IDs • NEAP ranking preserves winner-first order • every split is tenant-safe" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#34495E;" vertex="1" parent="r1"><mxGeometry x="80" y="94" width="4040" height="42" as="geometry"/></mxCell>
        <mxCell id="r-ranking" value="&lt;b&gt;Winner-first evaluation&lt;/b&gt;   C3: larger numeric priority wins (300 → 100)   •   Open-ITSI: ranking singleton orders matching NEAPs (rank 1 → last)   •   a Notable is claimed by one winning policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#7F8C8D;strokeWidth=2;align=center;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=16;fontColor=#34495E;" vertex="1" parent="r1"><mxGeometry x="330" y="160" width="3540" height="82" as="geometry"/></mxCell>

        <mxCell id="r-c3" value="&lt;i&gt;«ordered static catalog»&lt;/i&gt;&lt;br&gt;&lt;b&gt;C3 DEFAULT_INCIDENT_CREATION_RULES&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1B4F72&quot;&gt;Exact filters, definitions, thresholds and enabled state&lt;/font&gt;" style="swimlane;horizontal=1;startSize=120;container=1;collapsible=0;recursiveResize=0;rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2F8;swimlaneFillColor=#D6EAF8;strokeColor=#2874A6;strokeWidth=3;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#17202A;" vertex="1" parent="r1"><mxGeometry x="100" y="310" width="1450" height="1555" as="geometry"/></mxCell>
        <mxCell id="r-c3-fields" value="&lt;div style=&quot;height:173px;border-bottom:1px solid #A9CCE3;padding:16px;&quot;&gt;&lt;b&gt;300 · Meraki ThousandEyes application alert (per notification)&lt;/b&gt;&lt;br&gt;ENABLED • meraki + insights + thousand_eyes_application_alert + medium/high/critical • definition [] • min 1&lt;/div&gt;&lt;div style=&quot;height:173px;border-bottom:1px solid #A9CCE3;padding:16px;&quot;&gt;&lt;b&gt;290 · ThousandEyes high or critical&lt;/b&gt;&lt;br&gt;ENABLED • thousandeyes + high/critical • definition [] • min 1&lt;/div&gt;&lt;div style=&quot;height:173px;border-bottom:1px solid #A9CCE3;padding:16px;&quot;&gt;&lt;b&gt;280 · Agent Studio high or critical&lt;/b&gt;&lt;br&gt;ENABLED • agent_studio + high/critical • definition [] • min 1&lt;/div&gt;&lt;div style=&quot;height:173px;border-bottom:1px solid #A9CCE3;padding:16px;&quot;&gt;&lt;b&gt;250 · Topology group temporal correlation&lt;/b&gt;&lt;br&gt;ENABLED • high/critical • definition [topologyGroupId] • 30 min • min 1&lt;/div&gt;&lt;div style=&quot;height:173px;border-bottom:1px solid #A9CCE3;padding:16px;&quot;&gt;&lt;b&gt;200 · Group by device and product tenant&lt;/b&gt;&lt;br&gt;ENABLED • high/critical • [deviceId, productTenantId] • 30 min • min 1&lt;/div&gt;&lt;div style=&quot;height:173px;border-bottom:1px solid #A9CCE3;padding:16px;color:#922B21;&quot;&gt;&lt;b&gt;150 · Group by product, product tenant, and external notification type&lt;/b&gt;&lt;br&gt;DISABLED • high/critical • three-field definition • 30 min • &lt;b&gt;min 2 before candidate&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;height:173px;padding:16px;&quot;&gt;&lt;b&gt;100 · Single high or critical notification&lt;/b&gt;&lt;br&gt;DISABLED • high/critical • definition [] • min 1&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#17202A;" vertex="1" parent="r-c3"><mxGeometry x="0" y="120" width="1450" height="1435" as="geometry"/></mxCell>

        <mxCell id="r-open" value="&lt;i&gt;«bootstrap policy catalog»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Open-ITSI Default C3 NEAPs&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;Same title and _key as the C3 rule ID&lt;/font&gt;" style="swimlane;horizontal=1;startSize=120;container=1;collapsible=0;recursiveResize=0;rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F8F5;swimlaneFillColor=#D5F5E3;strokeColor=#148F77;strokeWidth=3;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#17202A;" vertex="1" parent="r1"><mxGeometry x="2650" y="310" width="1450" height="1555" as="geometry"/></mxCell>
        <mxCell id="r-open-fields" value="&lt;div style=&quot;height:173px;border-bottom:1px solid #A2D9CE;padding:16px;&quot;&gt;&lt;b&gt;Rank 1 · Meraki ThousandEyes application alert (per notification)&lt;/b&gt;&lt;br&gt;_key: meraki-insights-thousandeyes-application&lt;br&gt;ENABLED • exact C3 filters • split: tenant_id,c3_notification_id • pause 1800s&lt;/div&gt;&lt;div style=&quot;height:173px;border-bottom:1px solid #A2D9CE;padding:16px;&quot;&gt;&lt;b&gt;Rank 2 · ThousandEyes high or critical&lt;/b&gt;&lt;br&gt;_key: thousandeyes-high-or-critical&lt;br&gt;ENABLED • exact C3 filters • split: tenant_id,c3_notification_id • pause 1800s&lt;/div&gt;&lt;div style=&quot;height:173px;border-bottom:1px solid #A2D9CE;padding:16px;&quot;&gt;&lt;b&gt;Rank 3 · Agent Studio high or critical&lt;/b&gt;&lt;br&gt;_key: agent-studio-high-or-critical&lt;br&gt;ENABLED • exact C3 filters • split: tenant_id,c3_notification_id • pause 1800s&lt;/div&gt;&lt;div style=&quot;height:173px;border-bottom:1px solid #A2D9CE;padding:16px;&quot;&gt;&lt;b&gt;Rank 4 · Topology group temporal correlation&lt;/b&gt;&lt;br&gt;_key: topology-group-temporal&lt;br&gt;ENABLED • severity + nonempty topology • split: tenant_id,topology_group_id • pause 1800s&lt;/div&gt;&lt;div style=&quot;height:173px;border-bottom:1px solid #A2D9CE;padding:16px;&quot;&gt;&lt;b&gt;Rank 5 · Group by device and product tenant&lt;/b&gt;&lt;br&gt;_key: group-by-device-product-tenant&lt;br&gt;ENABLED • severity + required fields • split: tenant_id,primary_device_id,product_tenant_id • pause 1800s&lt;/div&gt;&lt;div style=&quot;height:173px;border-bottom:1px solid #E6B0AA;padding:16px;background:#FDEDEC;color:#922B21;&quot;&gt;&lt;b&gt;NO AUTO-CREATED NEAP&lt;/b&gt;&lt;br&gt;Ordinary NEAP grouping creates an Episode at member 1; it cannot faithfully reproduce C3's pre-creation minNotificationCount=2 threshold.&lt;/div&gt;&lt;div style=&quot;height:173px;padding:16px;&quot;&gt;&lt;b&gt;Last · Single high or critical notification&lt;/b&gt;&lt;br&gt;_key: single-high-or-critical&lt;br&gt;DISABLED • exact severity filter • split: tenant_id,c3_notification_id • pause 1800s&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#17202A;" vertex="1" parent="r-open"><mxGeometry x="0" y="120" width="1450" height="1435" as="geometry"/></mxCell>

        <mxCell id="r-map1" value="same name + ID • first" style="edgeStyle=none;rounded=0;html=1;curved=0;startArrow=none;endArrow=open;endFill=0;strokeColor=#148F77;strokeWidth=3;fontFamily=Helvetica;fontSize=15;fontColor=#0E6655;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.143;entryX=0;entryY=0.143;" edge="1" parent="r1" source="r-c3" target="r-open"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r-map2" value="same name + ID • second" style="edgeStyle=none;rounded=0;html=1;curved=0;startArrow=none;endArrow=open;endFill=0;strokeColor=#148F77;strokeWidth=3;fontFamily=Helvetica;fontSize=15;fontColor=#0E6655;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.275;entryX=0;entryY=0.275;" edge="1" parent="r1" source="r-c3" target="r-open"><mxGeometry relative="1" as="geometry"/></mxCell>
