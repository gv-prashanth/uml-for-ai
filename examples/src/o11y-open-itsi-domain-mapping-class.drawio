        <mxCell id="n-legend" value="&lt;b&gt;Legend&lt;/b&gt;  Blue solid = copied/renamed • Orange dashed = derived/defaulted • Teal = Open-ITSI domain • Gray dashed = validated or adapter-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#7F8C8D;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=15;fontColor=#34495E;" vertex="1" parent="root-1"><mxGeometry x="490" y="160" width="3220" height="72" as="geometry"/></mxCell>

        <mxCell id="n-o11y" value="&lt;i&gt;«normalized alert + trusted context»&lt;/i&gt;&lt;br&gt;&lt;b&gt;AlertDescription / TrustedScope&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1B4F72&quot;&gt;Eligible trigger plus enrichment metadata&lt;/font&gt;" style="swimlane;horizontal=1;startSize=120;container=1;collapsible=0;recursiveResize=0;rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2F8;swimlaneFillColor=#D6EAF8;strokeColor=#2874A6;strokeWidth=3;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#17202A;" vertex="1" parent="root-1"><mxGeometry x="100" y="310" width="1120" height="1590" as="geometry"/></mxCell>
        <mxCell id="n-o11y-fields" value="&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A9CCE3;&quot;&gt;org_id + env / environment&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A9CCE3;&quot;&gt;alert_id: uint64&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A9CCE3;&quot;&gt;alert_id + provider_epoch&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A9CCE3;&quot;&gt;canonical envelope before digest&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A9CCE3;&quot;&gt;timestamp_ms&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A9CCE3;&quot;&gt;state=triggering / is_=anomalous&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A9CCE3;&quot;&gt;severity&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A9CCE3;&quot;&gt;detector_id&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A9CCE3;&quot;&gt;detector_name | metadata fallback&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A9CCE3;&quot;&gt;description | metric fallback&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A9CCE3;&quot;&gt;metric_name?&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A9CCE3;&quot;&gt;primary_entity | EQS entity pair&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A9CCE3;&quot;&gt;dimensions + tags + enrichment_metadata&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A9CCE3;&quot;&gt;product alias?&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A9CCE3;&quot;&gt;category alias?&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A9CCE3;&quot;&gt;external notification type alias?&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A9CCE3;&quot;&gt;topology group alias?&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A9CCE3;&quot;&gt;primary device alias?&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A9CCE3;&quot;&gt;product tenant alias?&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;&quot;&gt;adapter constants + compatibility&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=24;spacingRight=18;fontFamily=Menlo;fontSize=16;fontColor=#17202A;" vertex="1" parent="n-o11y"><mxGeometry x="0" y="120" width="1120" height="1470" as="geometry"/></mxCell>

        <mxCell id="n-open" value="&lt;i&gt;«Kafka envelope + domain object»&lt;/i&gt;&lt;br&gt;&lt;b&gt;OpenItsiNotableMessage&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;openitsi.notable.v1 / notable.created&lt;/font&gt;" style="swimlane;horizontal=1;startSize=120;container=1;collapsible=0;recursiveResize=0;rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F8F5;swimlaneFillColor=#D5F5E3;strokeColor=#148F77;strokeWidth=3;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#17202A;" vertex="1" parent="root-1"><mxGeometry x="2980" y="310" width="1120" height="1590" as="geometry"/></mxCell>
        <mxCell id="n-open-fields" value="&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A2D9CE;&quot;&gt;scope.tenant_id = aidd:{org}:{sha256(env)}&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A2D9CE;&quot;&gt;notable.event_id / source_id&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A2D9CE;&quot;&gt;message_id + partition / lifecycle identities&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A2D9CE;&quot;&gt;content_digest = sha256(canonical JSON)&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A2D9CE;&quot;&gt;notable._time = timestamp_ms / 1000&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A2D9CE;&quot;&gt;submission eligibility only; not projected&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A2D9CE;&quot;&gt;notable.severity: critical/high/medium/low/info&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A2D9CE;&quot;&gt;notable.detector_id: string&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A2D9CE;&quot;&gt;notable.title&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A2D9CE;&quot;&gt;notable.description&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A2D9CE;&quot;&gt;notable.metric_name?&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A2D9CE;&quot;&gt;notable.primary_entity + derived device ID&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A2D9CE;&quot;&gt;accepted scalar aliases only&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A2D9CE;&quot;&gt;notable.product (default &amp;quot;o11y&amp;quot;)&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A2D9CE;&quot;&gt;notable.category?&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A2D9CE;&quot;&gt;notable.external_notification_type?&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A2D9CE;&quot;&gt;notable.topology_group_id?&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A2D9CE;&quot;&gt;notable.primary_device_id?&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;border-bottom:1px solid #A2D9CE;&quot;&gt;notable.product_tenant_id (default env)&lt;/div&gt;&lt;div style=&quot;height:70px;line-height:70px;&quot;&gt;status=&amp;quot;1&amp;quot; • source=&amp;quot;aidd-ims&amp;quot; • c3_notification_id&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=24;spacingRight=18;fontFamily=Menlo;fontSize=16;fontColor=#17202A;" vertex="1" parent="n-open"><mxGeometry x="0" y="120" width="1120" height="1470" as="geometry"/></mxCell>

