        <mxCell id="n-mode-note" value="&lt;b&gt;Implemented submission semantics&lt;/b&gt;&lt;br&gt;&lt;b&gt;native&lt;/b&gt; keeps the existing Incident Deducer path. &lt;b&gt;open_itsi&lt;/b&gt; accepts only triggering/anomalous alerts, stages the immutable Notable and publish intent in PostgreSQL, then returns without waiting for a grouping result." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F1;strokeColor=#C25700;strokeWidth=2;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=16;fontColor=#633000;" vertex="1" parent="root-1"><mxGeometry x="100" y="1970" width="4000" height="150" as="geometry"/></mxCell>
        <mxCell id="n-omitted" value="&lt;b&gt;Adapter boundary:&lt;/b&gt; tenant authority comes from trusted org_id + environment—not tags. Metadata contributes only scalar NEAP aliases. &lt;b&gt;Compatibility caveat:&lt;/b&gt; the current mapper still emits c3_notification_id = source_event_id for the reused bootstrap catalog." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#7F8C8D;strokeWidth=2;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=15;fontColor=#34495E;" vertex="1" parent="root-1"><mxGeometry x="100" y="2150" width="4000" height="120" as="geometry"/></mxCell>

        <mxCell id="e-group" value="" style="group;" vertex="1" connectable="0" parent="root-1"><mxGeometry y="2400" width="4200" height="2400" as="geometry"/></mxCell>
        <mxCell id="e-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="e-group"><mxGeometry width="4200" height="2400" as="geometry"/></mxCell>
        <mxCell id="e-title" value="Open-ITSI Episode Membership → O11y Incident Mutation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=38;fontStyle=1;fontColor=#17202A;" vertex="1" parent="e-group"><mxGeometry x="80" y="32" width="4040" height="58" as="geometry"/></mxCell>
        <mxCell id="e-subtitle" value="Open-ITSI owns the grouping decision • AIDD-IMS authenticates the delta, binds Episode to Incident, and invokes its existing mutator" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#34495E;" vertex="1" parent="e-group"><mxGeometry x="80" y="94" width="4040" height="42" as="geometry"/></mxCell>
        <mxCell id="e-legend" value="&lt;b&gt;Legend&lt;/b&gt;  Teal solid = authoritative membership fact • Orange dashed = derived binding/decision • Gray dashed = validate, observe or diagnose • Blue = AIDD-owned state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#7F8C8D;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=15;fontColor=#34495E;" vertex="1" parent="e-group"><mxGeometry x="540" y="160" width="3120" height="72" as="geometry"/></mxCell>

        <mxCell id="e-open" value="&lt;i&gt;«Kafka egress contract»&lt;/i&gt;&lt;br&gt;&lt;b&gt;OpenItsiMembershipEvent&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;episode.membership_added / append-only delta&lt;/font&gt;" style="swimlane;horizontal=1;startSize=120;container=1;collapsible=0;recursiveResize=0;rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F8F5;swimlaneFillColor=#D5F5E3;strokeColor=#148F77;strokeWidth=3;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#17202A;" vertex="1" parent="e-group"><mxGeometry x="100" y="310" width="1240" height="1290" as="geometry"/></mxCell>
        <mxCell id="e-open-fields" value="&lt;div style=&quot;height:84px;line-height:84px;border-bottom:1px solid #A2D9CE;&quot;&gt;schema_version: openitsi.episode-event.v1&lt;/div&gt;&lt;div style=&quot;height:84px;line-height:84px;border-bottom:1px solid #A2D9CE;&quot;&gt;message_id&lt;/div&gt;&lt;div style=&quot;height:84px;line-height:84px;border-bottom:1px solid #A2D9CE;&quot;&gt;event_type: episode.membership_added&lt;/div&gt;&lt;div style=&quot;height:84px;line-height:84px;border-bottom:1px solid #A2D9CE;&quot;&gt;emitted_at&lt;/div&gt;&lt;div style=&quot;height:84px;line-height:84px;border-bottom:1px solid #A2D9CE;&quot;&gt;scope.tenant_id&lt;/div&gt;&lt;div style=&quot;height:84px;line-height:84px;border-bottom:1px solid #A2D9CE;&quot;&gt;episode.episode_id&lt;/div&gt;&lt;div style=&quot;height:84px;line-height:84px;border-bottom:1px solid #A2D9CE;&quot;&gt;episode.policy_id&lt;/div&gt;&lt;div style=&quot;height:84px;line-height:84px;border-bottom:1px solid #A2D9CE;&quot;&gt;episode.revision&lt;/div&gt;&lt;div style=&quot;height:84px;line-height:84px;border-bottom:1px solid #A2D9CE;&quot;&gt;episode.member_count&lt;/div&gt;&lt;div style=&quot;height:84px;line-height:84px;border-bottom:1px solid #A2D9CE;&quot;&gt;membership.event_id&lt;/div&gt;&lt;div style=&quot;height:84px;line-height:84px;border-bottom:1px solid #A2D9CE;&quot;&gt;membership.source_message_id&lt;/div&gt;&lt;div style=&quot;height:84px;line-height:84px;border-bottom:1px solid #A2D9CE;&quot;&gt;membership.source_content_digest&lt;/div&gt;&lt;div style=&quot;height:84px;line-height:84px;&quot;&gt;provenance.grouped_hec_id&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=24;spacingRight=18;fontFamily=Menlo;fontSize=16;fontColor=#17202A;" vertex="1" parent="e-open"><mxGeometry x="0" y="120" width="1240" height="1170" as="geometry"/></mxCell>

        <mxCell id="e-aidd" value="&lt;i&gt;«validated inbox + decision projection»&lt;/i&gt;&lt;br&gt;&lt;b&gt;AIDD Membership / GroupingDecision&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1B4F72&quot;&gt;One authenticated source lifecycle to one Episode binding&lt;/font&gt;" style="swimlane;horizontal=1;startSize=120;container=1;collapsible=0;recursiveResize=0;rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2F8;swimlaneFillColor=#D6EAF8;strokeColor=#2874A6;strokeWidth=3;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#17202A;" vertex="1" parent="e-group"><mxGeometry x="2860" y="310" width="1240" height="1290" as="geometry"/></mxCell>
        <mxCell id="e-aidd-fields" value="&lt;div style=&quot;height:84px;line-height:84px;border-bottom:1px solid #A9CCE3;&quot;&gt;validate exact contract version&lt;/div&gt;&lt;div style=&quot;height:84px;line-height:84px;border-bottom:1px solid #A9CCE3;&quot;&gt;idempotent inbox key + deterministic ID check&lt;/div&gt;&lt;div style=&quot;height:84px;line-height:84px;border-bottom:1px solid #A9CCE3;&quot;&gt;accept membership-added only&lt;/div&gt;&lt;div style=&quot;height:84px;line-height:84px;border-bottom:1px solid #A9CCE3;&quot;&gt;received / diagnostic timestamp&lt;/div&gt;&lt;div style=&quot;height:84px;line-height:84px;border-bottom:1px solid #A9CCE3;&quot;&gt;exact trusted-scope match&lt;/div&gt;&lt;div style=&quot;height:84px;line-height:84px;border-bottom:1px solid #A9CCE3;&quot;&gt;episode_hash + scoped Episode binding&lt;/div&gt;&lt;div style=&quot;height:84px;line-height:84px;border-bottom:1px solid #A9CCE3;&quot;&gt;allowlist + source_heuristic + matched policy&lt;/div&gt;&lt;div style=&quot;height:84px;line-height:84px;border-bottom:1px solid #A9CCE3;&quot;&gt;ordered Episode mutation / stored revision&lt;/div&gt;&lt;div style=&quot;height:84px;line-height:84px;border-bottom:1px solid #A9CCE3;&quot;&gt;observed count; not Incident authority&lt;/div&gt;&lt;div style=&quot;height:84px;line-height:84px;border-bottom:1px solid #A9CCE3;&quot;&gt;load exact durable submission + alert lifecycle&lt;/div&gt;&lt;div style=&quot;height:84px;line-height:84px;border-bottom:1px solid #A9CCE3;&quot;&gt;exact source-message match&lt;/div&gt;&lt;div style=&quot;height:84px;line-height:84px;border-bottom:1px solid #A9CCE3;&quot;&gt;exact immutable-content match&lt;/div&gt;&lt;div style=&quot;height:84px;line-height:84px;&quot;&gt;diagnostics only&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=24;spacingRight=18;fontFamily=Menlo;fontSize=16;fontColor=#17202A;" vertex="1" parent="e-aidd"><mxGeometry x="0" y="120" width="1240" height="1170" as="geometry"/></mxCell>

