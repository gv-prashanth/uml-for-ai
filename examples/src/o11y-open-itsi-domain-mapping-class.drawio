        <mxCell id="e-map05" value="direct + authoritative scope check" style="edgeStyle=none;rounded=0;html=1;curved=0;startArrow=none;endArrow=open;endFill=0;strokeColor=#148F77;strokeWidth=2.5;fontFamily=Helvetica;fontSize=14;fontColor=#0E6655;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.386;entryX=0;entryY=0.386;" edge="1" parent="e-group" source="e-open" target="e-aidd"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-map06" value="hash for indexed binding; preserve original ID" style="edgeStyle=none;rounded=0;html=1;curved=0;startArrow=none;endArrow=open;endFill=0;dashed=1;dashPattern=7 5;strokeColor=#C25700;strokeWidth=2.5;fontFamily=Helvetica;fontSize=14;fontColor=#873600;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.451;entryX=0;entryY=0.451;" edge="1" parent="e-group" source="e-open" target="e-aidd"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-map07" value="direct after configured allowlist" style="edgeStyle=none;rounded=0;html=1;curved=0;startArrow=none;endArrow=open;endFill=0;strokeColor=#148F77;strokeWidth=2.5;fontFamily=Helvetica;fontSize=14;fontColor=#0E6655;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.516;entryX=0;entryY=0.516;" edge="1" parent="e-group" source="e-open" target="e-aidd"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-map08" value="persist + order one Episode's work" style="edgeStyle=none;rounded=0;html=1;curved=0;startArrow=none;endArrow=open;endFill=0;strokeColor=#148F77;strokeWidth=2.5;fontFamily=Helvetica;fontSize=14;fontColor=#0E6655;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.581;entryX=0;entryY=0.581;" edge="1" parent="e-group" source="e-open" target="e-aidd"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-map09" value="observe; Incident recounts persisted alerts" style="edgeStyle=none;rounded=0;html=1;curved=0;startArrow=none;endArrow=open;endFill=0;dashed=1;dashPattern=3 4;strokeColor=#7F8C8D;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#566573;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.646;entryX=0;entryY=0.646;" edge="1" parent="e-group" source="e-open" target="e-aidd"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-map10" value="cross-check source lifecycle" style="edgeStyle=none;rounded=0;html=1;curved=0;startArrow=none;endArrow=open;endFill=0;dashed=1;dashPattern=7 5;strokeColor=#C25700;strokeWidth=2.5;fontFamily=Helvetica;fontSize=14;fontColor=#873600;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.711;entryX=0;entryY=0.711;" edge="1" parent="e-group" source="e-open" target="e-aidd"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-map11" value="exact equality guard" style="edgeStyle=none;rounded=0;html=1;curved=0;startArrow=none;endArrow=open;endFill=0;dashed=1;dashPattern=7 5;strokeColor=#C25700;strokeWidth=2.5;fontFamily=Helvetica;fontSize=14;fontColor=#873600;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.776;entryX=0;entryY=0.776;" edge="1" parent="e-group" source="e-open" target="e-aidd"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-map12" value="exact digest guard" style="edgeStyle=none;rounded=0;html=1;curved=0;startArrow=none;endArrow=open;endFill=0;dashed=1;dashPattern=7 5;strokeColor=#C25700;strokeWidth=2.5;fontFamily=Helvetica;fontSize=14;fontColor=#873600;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.841;entryX=0;entryY=0.841;" edge="1" parent="e-group" source="e-open" target="e-aidd"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-map13" value="diagnostics only" style="edgeStyle=none;rounded=0;html=1;curved=0;startArrow=none;endArrow=open;endFill=0;dashed=1;dashPattern=3 4;strokeColor=#7F8C8D;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#566573;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.906;entryX=0;entryY=0.906;" edge="1" parent="e-group" source="e-open" target="e-aidd"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e-owned" value="&lt;i&gt;«AIDD-owned aggregate and lifecycle»&lt;/i&gt;&lt;br&gt;&lt;b&gt;IncidentMutator + Incident persistence&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;CREATE&lt;/b&gt; when no scoped Episode binding exists • &lt;b&gt;ATTACH&lt;/b&gt; when the binding resolves to an Incident&lt;br&gt;&lt;b&gt;correlation_metadata.matched&lt;/b&gt; adds openitsi:episode, openitsi:policy and the crash-recovery binding token • &lt;b&gt;rationale&lt;/b&gt; records policy, Episode and revision • &lt;b&gt;confidence_score&lt;/b&gt; = 1.0&lt;br&gt;&lt;b&gt;AIDD retains&lt;/b&gt; Incident ID, alert membership, title/description, severity/state, timeline, actions, persistence, events, REST API and UI projection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#2874A6;strokeWidth=3;align=left;verticalAlign=middle;spacing=22;fontFamily=Helvetica;fontSize=17;fontColor=#17202A;" vertex="1" parent="e-group"><mxGeometry x="680" y="1720" width="2840" height="340" as="geometry"/></mxCell>
        <mxCell id="e-owned-edge" value="validated membership chooses CREATE or ATTACH; existing mutator commits O11y state" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=none;endArrow=open;endFill=0;dashed=1;dashPattern=7 5;strokeColor=#2874A6;strokeWidth=2.5;fontFamily=Helvetica;fontSize=15;fontColor=#1B4F72;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="e-group" source="e-aidd" target="e-owned"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-boundary-note" value="&lt;b&gt;Ownership boundary:&lt;/b&gt; Open-ITSI decides Episode membership. AIDD persists the scoped Episode-to-Incident binding, serializes each Episode's mutations, fences clear races, and remains authoritative for the Incident lifecycle." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F1;strokeColor=#C25700;strokeWidth=2;align=center;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#633000;" vertex="1" parent="e-group"><mxGeometry x="420" y="2110" width="3360" height="130" as="geometry"/></mxCell>

        <mxCell id="r-group" value="" style="group;" vertex="1" connectable="0" parent="root-1"><mxGeometry y="4800" width="4200" height="2400" as="geometry"/></mxCell>
        <mxCell id="r-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="r-group"><mxGeometry width="4200" height="2400" as="geometry"/></mxCell>
        <mxCell id="r-title" value="AIDD Provider Controls → Open-ITSI Grouping Boundary" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=38;fontStyle=1;fontColor=#17202A;" vertex="1" parent="r-group"><mxGeometry x="80" y="32" width="4040" height="58" as="geometry"/></mxCell>
        <mxCell id="r-subtitle" value="The implemented seam swaps the grouping decision—not O11y persistence or lifecycle ownership • all result authority is revalidated at admission" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#34495E;" vertex="1" parent="r-group"><mxGeometry x="80" y="94" width="4040" height="42" as="geometry"/></mxCell>
        <mxCell id="r-banner" value="&lt;b&gt;Asynchronous boundary&lt;/b&gt;   alerts.filtered → durable work/outbox → openitsi.notables.v1 → packaged NEAP evaluation → openitsi.episode-events.v1 → durable inbox → IncidentMutator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#7F8C8D;strokeWidth=2;align=center;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=16;fontColor=#34495E;" vertex="1" parent="r-group"><mxGeometry x="330" y="160" width="3540" height="82" as="geometry"/></mxCell>

        <mxCell id="r-aidd" value="&lt;i&gt;«configuration + durable control state»&lt;/i&gt;&lt;br&gt;&lt;b&gt;AIDD Open-ITSI Provider Seam&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1B4F72&quot;&gt;Admission, replay safety and Incident authority&lt;/font&gt;" style="swimlane;horizontal=1;startSize=120;container=1;collapsible=0;recursiveResize=0;rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2F8;swimlaneFillColor=#D6EAF8;strokeColor=#2874A6;strokeWidth=3;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#17202A;" vertex="1" parent="r-group"><mxGeometry x="100" y="310" width="1450" height="1555" as="geometry"/></mxCell>
        <mxCell id="r-aidd-fields" value="&lt;div style=&quot;height:200px;border-bottom:1px solid #A9CCE3;padding:16px;&quot;&gt;&lt;b&gt;DEDUCER_GROUPING_PROVIDER&lt;/b&gt;&lt;br&gt;native (default) | open_itsi&lt;/div&gt;&lt;div style=&quot;height:200px;border-bottom:1px solid #A9CCE3;padding:16px;&quot;&gt;&lt;b&gt;OPENITSI_PROVIDER_EPOCH&lt;/b&gt;&lt;br&gt;explicit grouping generation identifier&lt;/div&gt;&lt;div style=&quot;height:200px;border-bottom:1px solid #A9CCE3;padding:16px;&quot;&gt;&lt;b&gt;Kafka contracts&lt;/b&gt;&lt;br&gt;input: openitsi.notables.v1&lt;br&gt;output: openitsi.episode-events.v1&lt;/div&gt;&lt;div style=&quot;height:200px;border-bottom:1px solid #A9CCE3;padding:16px;&quot;&gt;&lt;b&gt;OPENITSI_ALLOWED_POLICY_IDS&lt;/b&gt;&lt;br&gt;explicit configured result allowlist&lt;/div&gt;&lt;div style=&quot;height:200px;border-bottom:1px solid #A9CCE3;padding:16px;&quot;&gt;&lt;b&gt;TrustedScope + partition key&lt;/b&gt;&lt;br&gt;(org_id, environment) authority; one alert lifecycle ordered&lt;/div&gt;&lt;div style=&quot;height:200px;border-bottom:1px solid #A9CCE3;padding:16px;&quot;&gt;&lt;b&gt;Lifecycle fence&lt;/b&gt;&lt;br&gt;trigger / clear / result monotonic state&lt;/div&gt;&lt;div style=&quot;height:215px;padding:16px;&quot;&gt;&lt;b&gt;Durable bridge tables&lt;/b&gt;&lt;br&gt;grouping_work • membership_inbox • episode_binding • result_rejection&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#17202A;" vertex="1" parent="r-aidd"><mxGeometry x="0" y="120" width="1450" height="1435" as="geometry"/></mxCell>

        <mxCell id="r-open" value="&lt;i&gt;«decision provider contract»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Open-ITSI Runtime Semantics&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0E6655&quot;&gt;Packaged NEAP selection and Episode membership&lt;/font&gt;" style="swimlane;horizontal=1;startSize=120;container=1;collapsible=0;recursiveResize=0;rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F8F5;swimlaneFillColor=#D5F5E3;strokeColor=#148F77;strokeWidth=3;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#17202A;" vertex="1" parent="r-group"><mxGeometry x="2650" y="310" width="1450" height="1555" as="geometry"/></mxCell>
        <mxCell id="r-open-fields" value="&lt;div style=&quot;height:200px;border-bottom:1px solid #A2D9CE;padding:16px;&quot;&gt;&lt;b&gt;Provider selection&lt;/b&gt;&lt;br&gt;Only open_itsi publishes externally; native remains unchanged&lt;/div&gt;&lt;div style=&quot;height:200px;border-bottom:1px solid #A2D9CE;padding:16px;&quot;&gt;&lt;b&gt;Generation-fenced identities&lt;/b&gt;&lt;br&gt;source, message, partition and lifecycle IDs include epoch&lt;/div&gt;&lt;div style=&quot;height:200px;border-bottom:1px solid #A2D9CE;padding:16px;&quot;&gt;&lt;b&gt;Versioned wire events&lt;/b&gt;&lt;br&gt;notable.created → episode.membership_added&lt;/div&gt;&lt;div style=&quot;height:200px;border-bottom:1px solid #A2D9CE;padding:16px;&quot;&gt;&lt;b&gt;NEAP decision + admission&lt;/b&gt;&lt;br&gt;policy selects membership; AIDD accepts only allowlisted policy IDs&lt;/div&gt;&lt;div style=&quot;height:200px;border-bottom:1px solid #A2D9CE;padding:16px;&quot;&gt;&lt;b&gt;Tenant and Episode affinity&lt;/b&gt;&lt;br&gt;tenant_id scopes grouping; Episode key serializes mutation only&lt;/div&gt;&lt;div style=&quot;height:200px;border-bottom:1px solid #A2D9CE;padding:16px;&quot;&gt;&lt;b&gt;Clear-safe asynchronous result&lt;/b&gt;&lt;br&gt;late membership becomes no-op or native closure after apply&lt;/div&gt;&lt;div style=&quot;height:215px;padding:16px;&quot;&gt;&lt;b&gt;Decision only&lt;/b&gt;&lt;br&gt;AIDD owns CREATE / ATTACH, binding, lifecycle, actions, events, API and UI&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#17202A;" vertex="1" parent="r-open"><mxGeometry x="0" y="120" width="1450" height="1435" as="geometry"/></mxCell>

        <mxCell id="r-map01" value="choose exactly one grouping path" style="edgeStyle=none;rounded=0;html=1;curved=0;startArrow=none;endArrow=open;endFill=0;strokeColor=#148F77;strokeWidth=3;fontFamily=Helvetica;fontSize=15;fontColor=#0E6655;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.141;entryX=0;entryY=0.141;" edge="1" parent="r-group" source="r-aidd" target="r-open"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r-map02" value="fence deliberate provider rollout" style="edgeStyle=none;rounded=0;html=1;curved=0;startArrow=none;endArrow=open;endFill=0;dashed=1;dashPattern=7 5;strokeColor=#C25700;strokeWidth=2.5;fontFamily=Helvetica;fontSize=15;fontColor=#873600;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.270;entryX=0;entryY=0.270;" edge="1" parent="r-group" source="r-aidd" target="r-open"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r-map03" value="publish and consume through Kafka" style="edgeStyle=none;rounded=0;html=1;curved=0;startArrow=none;endArrow=open;endFill=0;strokeColor=#148F77;strokeWidth=3;fontFamily=Helvetica;fontSize=15;fontColor=#0E6655;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.399;entryX=0;entryY=0.399;" edge="1" parent="r-group" source="r-aidd" target="r-open"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r-map04" value="fail closed on unknown policy" style="edgeStyle=none;rounded=0;html=1;curved=0;startArrow=none;endArrow=open;endFill=0;dashed=1;dashPattern=7 5;strokeColor=#C25700;strokeWidth=2.5;fontFamily=Helvetica;fontSize=15;fontColor=#873600;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.528;entryX=0;entryY=0.528;" edge="1" parent="r-group" source="r-aidd" target="r-open"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r-map05" value="scope grouping and serialize one Episode" style="edgeStyle=none;rounded=0;html=1;curved=0;startArrow=none;endArrow=open;endFill=0;strokeColor=#148F77;strokeWidth=3;fontFamily=Helvetica;fontSize=15;fontColor=#0E6655;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.657;entryX=0;entryY=0.657;" edge="1" parent="r-group" source="r-aidd" target="r-open"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r-map06" value="reconcile clear races without resurrection" style="edgeStyle=none;rounded=0;html=1;curved=0;startArrow=none;endArrow=open;endFill=0;dashed=1;dashPattern=7 5;strokeColor=#C25700;strokeWidth=2.5;fontFamily=Helvetica;fontSize=15;fontColor=#873600;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.786;entryX=0;entryY=0.786;" edge="1" parent="r-group" source="r-aidd" target="r-open"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r-map07" value="return membership intent; retain O11y authority" style="edgeStyle=none;rounded=0;html=1;curved=0;startArrow=none;endArrow=open;endFill=0;strokeColor=#148F77;strokeWidth=3;fontFamily=Helvetica;fontSize=15;fontColor=#0E6655;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.920;entryX=0;entryY=0.920;" edge="1" parent="r-group" source="r-aidd" target="r-open"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="r-caution" value="&lt;b&gt;Current-policy caveat:&lt;/b&gt; the adapter is implemented, but the bundled bootstrap catalog is still largely C3-shaped. The mapper defaults product=o11y and product_tenant_id=environment, still emits c3_notification_id for compatibility, and allowlists itsi_default_policy. O11y-specific NEAP design remains separate work." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F1;strokeColor=#C25700;strokeWidth=2;align=center;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#633000;" vertex="1" parent="r-group"><mxGeometry x="220" y="1930" width="3760" height="160" as="geometry"/></mxCell>
