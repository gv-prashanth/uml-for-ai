          <mxGeometry x="-15" y="250" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="port_notification_queue_label" value="notificationQueue" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#654D0B;" vertex="1" parent="processor_boundary">
          <mxGeometry x="20" y="215" width="230" height="34" as="geometry" />
        </mxCell>
        <mxCell id="port_alert_events" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A77B18;strokeWidth=2.5;" vertex="1" parent="processor_boundary">
