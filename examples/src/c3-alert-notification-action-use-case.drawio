        <mxCell id="note-runtime-order" parent="c3-boundary" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#F2F8FC;strokeColor=#5A93B8;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=13;fontColor=#264F69;" value="&lt;b&gt;Runtime order — not a UML dependency chain&lt;/b&gt;&lt;br&gt;Normalize → identity/freshness dedupe → optional Notification classifier → persist Notification + optional topology lookup → exact-rule correlation → conditional Incident classifier → persist Action/Incident + Notification links.&lt;br&gt;&lt;b&gt;Access:&lt;/b&gt; every user/API read and write is tenant- and RBAC-scoped; Action visibility requires all linked Notifications to be visible." vertex="1">
          <mxGeometry x="280" y="2390" width="1450" height="205" as="geometry" />
        </mxCell>
        <mxCell id="note-current-limits" parent="c3-boundary" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#F8F7FA;strokeColor=#7E6B8E;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=12;fontColor=#4D4058;" value="&lt;b&gt;Current boundary&lt;/b&gt;&lt;br&gt;Action is the UI term for a persisted Incident plus Notification links. Rules are static, exact and code-deployed; optional topology contributes one exact group ID, not graph RCA. AI adds metadata/narrative and never chooses membership, severity or status. CREATE / MERGE / UPDATE / RESOLVE maintain one Incident and its links. No user-authored rules, causal grouping, Action-to-Action merge/split/recluster, or final enriched Action event exists in the reviewed implementation." vertex="1">
          <mxGeometry x="1770" y="2390" width="620" height="205" as="geometry" />
        </mxCell>

