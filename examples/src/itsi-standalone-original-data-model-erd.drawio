        <mxCell id="entity-derived-header" value="«derived entity» • PRIMARY PSR BOTTLENECK&lt;br&gt;&lt;b&gt;Episode Projection — NOT A TABLE&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=#F5B7B1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontColor=#78281F;fontStyle=1;" vertex="1" parent="entity-derived-episode"><mxGeometry x="0" y="0" width="1050" height="78" as="geometry"/></mxCell>
        <mxCell id="entity-derived-attrs" value="&lt;b&gt;ID&lt;/b&gt;  episode_key = union of:&lt;br&gt;  system.document_key&lt;br&gt;  user.document_key&lt;br&gt;  HEC envelope.event.itsi_group_id&lt;br&gt;&lt;br&gt;Read path overlays system → user → latest HEC snapshot.&lt;br&gt;List path scans/JSON-decodes all three sources, window-ranks HEC,&lt;br&gt;unions keys, computes exact COUNT, then repeats for ORDER + LIMIT.&lt;br&gt;&lt;br&gt;&lt;b&gt;There is no indexed one-row-per-episode read model.&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=18;spacingTop=14;fontFamily=Menlo;fontSize=14;fontColor=#17202A;" vertex="1" parent="entity-derived-episode"><mxGeometry x="0" y="79" width="1050" height="421" as="geometry"/></mxCell>

