        <mxCell id="mult-action-many" value="0..*" style="text;html=1;strokeColor=none;fillColor=#F8FAFC;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#2C3E50;" vertex="1" parent="logical-boundary"><mxGeometry x="2675" y="1038" width="46" height="22" as="geometry"/></mxCell>

        <mxCell id="rel-action-webhook" value="webhook_name + duplicated URI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=8 5;endArrow=none;startArrow=none;strokeColor=#5D6D7E;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#2C3E50;labelBackgroundColor=#F8FAFC;exitX=0.72;exitY=1;entryX=0.72;entryY=0;" edge="1" parent="logical-boundary" source="entity-action-job" target="entity-webhook"><mxGeometry x="0" y="-12" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="mult-webhook-jobs" value="0..*" style="text;html=1;strokeColor=none;fillColor=#F8FAFC;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#2C3E50;" vertex="1" parent="logical-boundary"><mxGeometry x="3285" y="1315" width="46" height="22" as="geometry"/></mxCell>
        <mxCell id="mult-webhook-optional" value="0..1" style="text;html=1;strokeColor=none;fillColor=#F8FAFC;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#2C3E50;" vertex="1" parent="logical-boundary"><mxGeometry x="3285" y="1480" width="46" height="22" as="geometry"/></mxCell>

        <mxCell id="rel-action-execution" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=8 5;endArrow=none;startArrow=none;strokeColor=#5D6D7E;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#2C3E50;labelBackgroundColor=#F8FAFC;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="logical-boundary" source="entity-action-job" target="entity-action-execution"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2930" y="1430"/><mxPoint x="2670" y="1430"/><mxPoint x="2670" y="2000"/><mxPoint x="2930" y="2000"/></Array></mxGeometry></mxCell>
        <mxCell id="label-action-execution" value="same queue key&lt;br&gt;(or deterministic hash)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#2C3E50;" vertex="1" parent="logical-boundary"><mxGeometry x="2400" y="1810" width="250" height="58" as="geometry"/></mxCell>
        <mxCell id="mult-job-exec" value="0..1" style="text;html=1;strokeColor=none;fillColor=#F8FAFC;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#2C3E50;" vertex="1" parent="logical-boundary"><mxGeometry x="2880" y="1310" width="46" height="22" as="geometry"/></mxCell>
        <mxCell id="mult-exec-job" value="0..1" style="text;html=1;strokeColor=none;fillColor=#F8FAFC;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#2C3E50;" vertex="1" parent="logical-boundary"><mxGeometry x="2880" y="2038" width="46" height="22" as="geometry"/></mxCell>

        <!-- Cross-boundary explanatory dependencies -->
        <mxCell id="dep-documents-logical" value="collection_name chooses JSON subtype" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=7 5;endArrow=open;endFill=0;startArrow=none;strokeColor=#5D6D7E;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#2C3E50;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.35;entryX=0;entryY=0.5;" edge="1" parent="1" source="table-documents" target="logical-discriminator-note">
          <mxGeometry x="0" y="-12" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="dep-hec-envelope" value="envelope_json contains" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=7 5;endArrow=open;endFill=0;startArrow=none;strokeColor=#B03A2E;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#78281F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4;entryX=0;entryY=0.55;" edge="1" parent="1" source="table-hec-events" target="entity-hec-envelope">
          <mxGeometry x="0" y="-12" relative="1" as="geometry"><Array as="points"><mxPoint x="2200" y="2480"/><mxPoint x="2200" y="1944"/></Array><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- PSR / SCALABILITY LENS -->
        <mxCell id="psr-boundary" value="&lt;b&gt;PSR SCALABILITY LENS — WHAT THIS MODEL MAKES EXPENSIVE&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDFEFE;strokeColor=#B03A2E;strokeWidth=3;align=left;verticalAlign=top;spacingTop=16;spacingLeft=20;fontFamily=Helvetica;fontSize=19;fontColor=#78281F;container=1;collapsible=0;recursiveResize=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="3160" width="5840" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="psr-tenant" value="&lt;b&gt;1 • No tenant boundary&lt;/b&gt;&lt;br&gt;No table, PK, or index contains tenant_id. A multi-tenant service would share collection names, keys, locks, histories, and query work." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#B03A2E;strokeWidth=2;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#78281F;" vertex="1" parent="psr-boundary"><mxGeometry x="90" y="100" width="1040" height="190" as="geometry"/></mxCell>
        <mxCell id="psr-episode" value="&lt;b&gt;2 • Episode rebuilt at read time&lt;/b&gt;&lt;br&gt;All system/user rows and grouped HEC history are scanned, JSON-decoded, window-ranked and sorted twice before LIMIT. This is the direct all-time 504 path." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#B03A2E;strokeWidth=2;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#78281F;" vertex="1" parent="psr-boundary"><mxGeometry x="1210" y="100" width="1040" height="190" as="geometry"/></mxCell>
        <mxCell id="psr-growth" value="&lt;b&gt;3 • Histories grow without lifecycle policy&lt;/b&gt;&lt;br&gt;HEC snapshots, tracked inputs, request audits, ACKs, runtime errors and EventiQ runs lack TTL/retention. Search results persist until explicit DELETE." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#B03A2E;strokeWidth=2;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#78281F;" vertex="1" parent="psr-boundary"><mxGeometry x="2330" y="100" width="1040" height="190" as="geometry"/></mxCell>
        <mxCell id="psr-json" value="&lt;b&gt;4 • Core joins are soft JSON joins&lt;/b&gt;&lt;br&gt;Policy, event, episode, webhook and queue links are neither validated nor indexed as relational keys. Orphans and repeated snapshots are structurally permitted." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#B03A2E;strokeWidth=2;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#78281F;" vertex="1" parent="psr-boundary"><mxGeometry x="3450" y="100" width="1040" height="190" as="geometry"/></mxCell>
        <mxCell id="psr-isolation" value="&lt;b&gt;5 • One SQLite file mixes workloads&lt;/b&gt;&lt;br&gt;Configuration, current state, histories, audits and large search results share WAL, connection-per-operation access, and one process-wide writer lock." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#B03A2E;strokeWidth=2;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#78281F;" vertex="1" parent="psr-boundary"><mxGeometry x="4570" y="100" width="1180" height="190" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend:&lt;/b&gt; orange-bordered = physical SQLite table • blue header = logical JSON document subtype • red border = PSR hot path / growth risk • dashed association = application/JSON relationship, not a database foreign key • multiplicities describe intended logical cardinality and may be violated by stored data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#7F8C8D;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;fontFamily=Helvetica;fontSize=14;fontColor=#34495E;" vertex="1" parent="psr-boundary"><mxGeometry x="90" y="340" width="5660" height="130" as="geometry"/></mxCell>

        <mxCell id="footer" value="Scope note: NATS JetStream (itsi_indexes / itsi_tracked_alerts, one-hour file retention) is transport state outside SQLite and is intentionally contextual rather than modeled as a relational entity. The immutable .spl library contains executable behavior, not writable application data." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#5D6D7E;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="200" y="3730" width="5600" height="45" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
