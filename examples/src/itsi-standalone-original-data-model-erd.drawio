        <mxCell id="entity-tracked-attrs" value="collection: openitsi_tracked_events&lt;br&gt;&lt;b&gt;ID&lt;/b&gt;  _key = SHA-256({event,time})&lt;br&gt;event: JSON object&lt;br&gt;  event.event_id  {logical event identity}&lt;br&gt;  title / severity / status / owner / source / ...&lt;br&gt;time: REAL&lt;br&gt;&lt;br&gt;Persisted after NATS PubAck • no stream sequence retained" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=16;spacingTop=12;fontFamily=Menlo;fontSize=13;fontColor=#17202A;" vertex="1" parent="entity-tracked-event"><mxGeometry x="0" y="63" width="790" height="307" as="geometry"/></mxCell>

