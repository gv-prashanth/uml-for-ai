        <mxCell id="entity-hec-attrs" value="stored in: hec_events.envelope_json&lt;br&gt;index = itsi_grouped_alerts&lt;br&gt;event.itsi_group_id  {episode_key}&lt;br&gt;event.event_id  {soft tracked-event ref}&lt;br&gt;event.itsi_policy_id  {soft policy ref}&lt;br&gt;event.itsi_is_first_event / itsi_is_last_event&lt;br&gt;event.itsi_dummy_closing_flag&lt;br&gt;group presentation fields and EventiQ state&lt;br&gt;&lt;br&gt;0..* historical snapshots per episode&lt;br&gt;Repeated close snapshots are not deduplicated" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=16;spacingTop=11;fontFamily=Menlo;fontSize=13;fontColor=#17202A;" vertex="1" parent="entity-hec-envelope"><mxGeometry x="0" y="69" width="850" height="411" as="geometry"/></mxCell>

